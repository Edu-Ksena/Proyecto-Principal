<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EDUK</title>
    <!-- Google Fonts: Outfit & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-container">
        <!-- Sidebar lateral -->
        <aside class="sidebar">
            <!-- Sección Colegio -->
            <div class="sidebar-section school-section">
                <div class="badge-circle gray-badge">CE</div>
                <div class="section-text">
                    <span class="main-title">Colegio</span>
                    <span class="subtitle">Educativo San Luis</span>
                </div>
            </div>

            <!-- Sección Administrador -->
            <div class="sidebar-section admin-section">
                <div class="badge-circle blue-badge">AR</div>
                <div class="section-text">
                    <span class="main-title">Andres RAMIREZ</span>
                    <span class="subtitle">Administrador</span>
                </div>
            </div>

            <hr class="sidebar-divider" />

            <!-- Menú Principal -->
            <div class="menu-label">Menú principal</div>
            <nav class="sidebar-nav">
                <ul>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminHome" ? "active" : "")">
                        <a asp-controller="AdminHome" asp-action="Index">
                            <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                <polyline points="9 22 9 12 15 12 15 22"></polyline>
                            </svg>
                            <span>INICIO</span>
                        </a>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Students" ? "active" : "")">
                        <a asp-controller="Students" asp-action="Index">
                            <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                            <span>ESTUDIANTES</span>
                        </a>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Teachers" ? "active" : "")">
                        <a asp-controller="Teachers" asp-action="Index">
                            <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 14c4 0 7-3 7-7s-3-7-7-7-7 3-7 7 3 7 7 7z"></path>
                                <path d="M2 21a10 10 0 0 1 20 0"></path>
                            </svg>
                            <span>PROFESORES</span>
                        </a>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Courses" ? "active" : "")">
                        <a asp-controller="Courses" asp-action="Index">
                            <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                                <polyline points="2 17 12 22 22 17"></polyline>
                                <polyline points="2 12 12 17 22 12"></polyline>
                            </svg>
                            <span>CURSOS</span>
                        </a>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Schedules" ? "active" : "")">
                        <a asp-controller="Schedules" asp-action="Index">
                            <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                            <span>HORARIOS</span>
                        </a>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Voting" ? "active" : "")">
                        <a asp-controller="Voting" asp-action="Index">
                            <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                            </svg>
                            <span>VOTACIONES</span>
                        </a>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminHome" && (ViewContext.RouteData.Values["Action"]?.ToString()?.Contains("Calificacion") == true) ? "active" : "")">
                        <a asp-controller="AdminHome" asp-action="Calificaciones">
                            <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                                <line x1="16" y1="13" x2="8" y2="13"></line>
                                <line x1="16" y1="17" x2="8" y2="17"></line>
                                <polyline points="10 9 9 9 8 9"></polyline>
                            </svg>
                            <span>ACADÉMICO</span>
                        </a>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Settings" ? "active" : "")">
                        <a asp-controller="Settings" asp-action="Index">
                            <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="3"></circle>
                                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                            </svg>
                            <span>CONFIGURACION</span>
                        </a>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Account" ? "active" : "")">
                        <a asp-controller="Account" asp-action="Login">
                            <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                                <polyline points="10 17 15 12 10 7"></polyline>
                                <line x1="15" y1="12" x2="3" y2="12"></line>
                            </svg>
                            <span>INICIAR SESIÓN / SALIR</span>
                        </a>
                    </li>
                </ul>
            </nav>

            <!-- Logo EDUK en la parte inferior -->
            <div class="sidebar-logo">
                <div class="logo-box">
                    <svg viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="4">
                        <polygon points="40,10 70,25 70,55 40,70 10,55 10,25"></polygon>
                        <polyline points="10,25 40,40 70,25"></polyline>
                        <line x1="40" y1="40" x2="40" y2="70"></line>
                        <polyline points="25,17.5 55,32.5"></polyline>
                        <polyline points="25,47.5 55,62.5"></polyline>
                    </svg>
                </div>
                <div class="logo-text">EDUK</div>
            </div>
        </aside>

        <!-- Contenido principal -->
        <div class="main-layout">
            <!-- Barra superior -->
            <header class="topbar">
                <button id="mobile-menu-btn" class="mobile-menu-btn" aria-label="Abrir Menú">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>
                <div class="topbar-title">
                    @ViewData["SectionTitle"]
                </div>
                <div class="topbar-right">
                    <!-- Buscador general -->
                    <div class="search-box-container">
                        <form method="get" action="@Url.Action("Index", ViewContext.RouteData.Values["Controller"]?.ToString())">
                            <span class="search-icon-span">
                                <svg class="search-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <circle cx="11" cy="11" r="8"></circle>
                                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                </svg>
                            </span>
                            <input type="text" name="searchString" placeholder="Buscar..." value="@ViewData["CurrentFilter"]" />
                        </form>
                    </div>

                    <!-- Fecha -->
                    <div class="topbar-date">
                        Viernes, 26 de marzo de 2026
                    </div>

                    <!-- Notificaciones -->
                    <button class="notification-btn" aria-label="Notificaciones">
                        <svg viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z"></path>
                        </svg>
                        <span class="notification-badge"></span>
                    </button>

                    <!-- Avatar del administrador -->
                    <div class="badge-circle blue-badge header-avatar">AR</div>
                </div>
            </header>

            <!-- Cuerpo de la vista -->
            <main class="content-body">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["SuccessMessage"]
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
