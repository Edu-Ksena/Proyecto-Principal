<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Colegio Educativo San Luis</title>
    <meta name="description" content="Portal estudiantil del Colegio Educativo San Luis — accede a tu información académica, horario, asistencia y más." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/estudiante.css" />
</head>
<body>
    <div class="app-shell">

        <!-- SIDEBAR: barra lateral de navegación -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <div class="brand-icon">CE</div>
                <div class="brand-text">
                    <span class="brand-name">Colegio</span>
                    <span class="brand-sub">Educativo San Luis</span>
                </div>
            </div>

            <div class="student-card">
                <div class="student-avatar">LA</div>
                <div class="student-info">
                    <span class="student-name">Laura Arbeláez</span>
                    <span class="student-grade">Grado 11° · Jornada Mañana</span>
                    <span class="student-code">Cod: 20240089</span>
                </div>
            </div>

            <nav class="sidebar-nav">
                <span class="nav-label">MENU PRINCIPAL</span>
                <a asp-controller="StudentHome" asp-action="Index" class="nav-item @(ViewData["ActivePage"]?.ToString() == "Inicio" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9,22 9,12 15,12 15,22"/></svg>
                    Inicio
                </a>
                <a asp-controller="Academico" asp-action="Index" class="nav-item @(ViewData["ActivePage"]?.ToString() == "Académico" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg>
                    Academico
                </a>
                <a asp-controller="Horario" asp-action="Index" class="nav-item @(ViewData["ActivePage"]?.ToString() == "Horario" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    Horario
                </a>
                <a asp-controller="Asistencia" asp-action="Index" class="nav-item @(ViewData["ActivePage"]?.ToString() == "Asistencia" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9,11 12,14 22,4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
                    Asistencia
                </a>
                <a asp-controller="Elecciones" asp-action="Index" class="nav-item @(ViewData["ActivePage"]?.ToString() == "Elecciones" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 10h14v10H5z" /><line x1="8" y1="10" x2="16" y2="10" /><path d="M9 3h6v4H9z" /></svg>
                    Elecciones
                </a>
                <a asp-controller="Perfil" asp-action="Index" class="nav-item @(ViewData["ActivePage"]?.ToString() == "Mi Perfil" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    Mi Perfil
                </a>
                <a asp-controller="Home" asp-action="Index" class="nav-item nav-logout">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16,17 21,12 16,7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    Cerrar sesion
                </a>
            </nav>
        </aside>

        <!--
            OVERLAY: capa semitransparente que aparece cuando el sidebar está abierto en móvil.
            Al hacer clic en él, se cierra el sidebar.
        -->
        <div id="sidebar-overlay"></div>

        <!-- CONTENIDO PRINCIPAL -->
        <main class="main-content" id="main-content">

            <!--
                BOTON HAMBURGUESA: visible solo en móvil (display: none en escritorio).
                Al hacer clic abre o cierra el sidebar lateral.
            -->
            <button
                class="btn-hamburguesa"
                id="btn-hamburguesa"
                aria-label="Abrir menu de navegacion"
                title="Abrir menu">
                &#9776;
            </button>

            @RenderBody()
        </main>
    </div>

    <script src="~/js/estudiante.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
