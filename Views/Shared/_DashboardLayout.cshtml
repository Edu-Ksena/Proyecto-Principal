<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] | EDU-K</title>
    
    <!-- Importamos la tipografía Inter como fue solicitado -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Iconos FontAwesome para la interfaz del panel -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Enlace a la hoja de estilos principal -->
    <link rel="stylesheet" href="~/css/Styles.css" asp-append-version="true">
    
    <!-- Estilos específicos del Dashboard con la paleta de colores y #062542 como principal -->
    <style>
        /* 
         * Paleta de colores principal para la interfaz de profesor:
         * Color Principal: #062542 (Azul oscuro profundo)
         * Color Secundario: #EBF1FE (Azul grisáceo claro para fondos)
         * Acentuados: #1fb398 (Verde menta), #ff5757 (Rojo suave), #f59e0b (Amarillo/Naranja)
         */
        body.db-layout {
            margin: 0;
            font-family: 'Inter', sans-serif;
            background-color: #EBF1FE;
            display: flex;
            height: 100vh;
            overflow: hidden;
            color: #333;
        }

        /* BARRA LATERAL (SIDEBAR) */
        .db-sidebar {
            width: 280px;
            background-color: #062542; /* Color principal */
            color: #ffffff;
            display: flex;
            flex-direction: column;
            border-right: 1px solid rgba(255, 255, 255, 0.1);
            padding: 20px 0;
            flex-shrink: 0;
            z-index: 10;
        }

        /* Encabezado Colegio en Sidebar */
        .sidebar-colegio {
            display: flex;
            align-items: center;
            padding: 0 24px 20px 24px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 20px;
        }

        .colegio-logo {
            width: 40px;
            height: 40px;
            background-color: #3b82f6;
            color: #white;
            font-weight: bold;
            font-size: 16px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
            color: white;
        }

        .colegio-info h3 {
            font-size: 14px;
            font-weight: 600;
            margin: 0;
            color: #ffffff;
        }

        .colegio-info p {
            font-size: 11px;
            margin: 2px 0 0 0;
            color: rgba(255, 255, 255, 0.6);
        }

        /* Banner de Perfil del Profesor en Sidebar */
        .sidebar-profile {
            background-color: rgba(255, 255, 255, 0.04);
            border-radius: 12px;
            margin: 0 16px 24px 16px;
            padding: 16px;
            display: flex;
            flex-direction: column;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .profile-header-info {
            display: flex;
            align-items: center;
            margin-bottom: 10px;
        }

        .profile-avatar-circle {
            width: 44px;
            height: 44px;
            background-color: #3b82f6;
            color: white;
            font-weight: bold;
            font-size: 18px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
            border: 2px solid rgba(255, 255, 255, 0.2);
        }

        .profile-names h4 {
            font-size: 14px;
            font-weight: 600;
            margin: 0;
            color: #ffffff;
        }

        .profile-names p {
            font-size: 11px;
            margin: 2px 0 0 0;
            color: rgba(255, 255, 255, 0.5);
            word-break: break-all;
        }

        .profile-role-badge {
            align-self: flex-start;
            background-color: rgba(255, 255, 255, 0.1);
            color: #ffffff;
            font-size: 11px;
            font-weight: 500;
            padding: 4px 10px;
            border-radius: 20px;
            margin-top: 5px;
        }

        /* Menú de Navegación */
        .sidebar-menu-title {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255, 255, 255, 0.4);
            padding: 0 24px;
            margin-bottom: 12px;
            font-weight: 700;
        }

        .sidebar-nav-list {
            display: flex;
            flex-direction: column;
            gap: 4px;
            padding: 0 12px;
            flex-grow: 1;
        }

        .db-nav-item {
            display: flex;
            align-items: center;
            padding: 12px 16px;
            color: rgba(255, 255, 255, 0.7);
            text-decoration: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.2s ease-in-out;
        }

        .db-nav-item i {
            margin-right: 12px;
            font-size: 16px;
            width: 20px;
            text-align: center;
            transition: all 0.2s;
        }

        .db-nav-item:hover {
            background-color: rgba(255, 255, 255, 0.08);
            color: #ffffff;
        }

        .db-nav-item.active {
            background-color: rgba(255, 255, 255, 0.15);
            color: #ffffff;
            font-weight: 600;
            border-left: 4px solid #3b82f6;
        }

        /* Botón Cerrar Sesión en Sidebar */
        .sidebar-footer {
            padding: 16px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .btn-cerrar-sesion {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding: 12px;
            background-color: rgba(255, 87, 87, 0.1);
            color: #ff5757;
            text-decoration: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.2s;
            border: 1px solid rgba(255, 87, 87, 0.2);
        }

        .btn-cerrar-sesion:hover {
            background-color: #ff5757;
            color: #ffffff;
        }

        .btn-cerrar-sesion i {
            margin-right: 8px;
        }

        /* ÁREA DE CONTENIDO PRINCIPAL (MAIN PANEL) */
        .db-main-panel {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
        }

        /* Barra Superior (Topbar) */
        .db-topbar {
            background-color: #ffffff;
            height: 70px;
            border-bottom: 1px solid rgba(6, 37, 66, 0.1);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
            flex-shrink: 0;
        }

        .topbar-breadcrumb {
            display: flex;
            flex-direction: column;
        }

        .topbar-breadcrumb span {
            font-size: 12px;
            color: #777;
            font-weight: 500;
        }

        .topbar-breadcrumb h2 {
            font-size: 20px;
            font-weight: 700;
            color: #062542; /* Color principal */
            margin: 2px 0 0 0;
        }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .topbar-notifications-btn {
            position: relative;
            background: none;
            border: none;
            font-size: 20px;
            color: #062542;
            cursor: pointer;
            transition: color 0.2s;
        }

        .topbar-notifications-btn:hover {
            color: #3b82f6;
        }

        .notifications-badge {
            position: absolute;
            top: -2px;
            right: -2px;
            width: 8px;
            height: 8px;
            background-color: #ff5757;
            border-radius: 50%;
            border: 2px solid #ffffff;
        }

        .topbar-user-avatar {
            width: 38px;
            height: 38px;
            background-color: #3b82f6;
            color: white;
            font-weight: bold;
            font-size: 14px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid rgba(6, 37, 66, 0.1);
            cursor: pointer;
        }

        /* Contenedor del Cuerpo de la Vista */
        .db-view-body {
            flex-grow: 1;
            padding: 30px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        /* PIE DE PÁGINA (FOOTER) */
        .db-footer {
            background-color: #062542; /* Color principal */
            color: rgba(255, 255, 255, 0.6);
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
            font-size: 12px;
            flex-shrink: 0;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        .db-footer-links {
            display: flex;
            gap: 15px;
        }

        .db-footer-links a {
            color: rgba(255, 255, 255, 0.6);
            text-decoration: none;
            transition: color 0.2s;
        }

        .db-footer-links a:hover {
            color: #ffffff;
        }

        /* TARJETAS PREMIUM DE DATOS Y LISTADOS */
        .db-card {
            background-color: #ffffff;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(6, 37, 66, 0.05);
            padding: 24px;
            border: 1px solid rgba(6, 37, 66, 0.05);
        }

        .db-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .db-card-header h3 {
            font-size: 18px;
            font-weight: 700;
            color: #062542;
            margin: 0;
        }

        .db-card-btn-all {
            background: none;
            border: 1px solid #062542;
            color: #062542;
            font-size: 12px;
            font-weight: 600;
            padding: 6px 16px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
        }

        .db-card-btn-all:hover {
            background-color: #062542;
            color: #ffffff;
        }

        /* Filas de elementos en las listas */
        .db-item-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 0;
            border-bottom: 1px solid rgba(6, 37, 66, 0.05);
        }

        .db-item-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .db-item-info {
            display: flex;
            align-items: center;
        }

        .db-item-circle-icon {
            width: 38px;
            height: 38px;
            background-color: rgba(6, 37, 66, 0.05);
            color: #062542;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
            font-weight: 600;
            font-size: 13px;
        }

        .db-item-details h4 {
            font-size: 14px;
            font-weight: 600;
            color: #062542;
            margin: 0;
        }

        .db-item-details p {
            font-size: 12px;
            color: #666;
            margin: 2px 0 0 0;
        }

        /* Pastillas de Estado (Pills) */
        .db-pill {
            font-size: 11px;
            font-weight: 700;
            padding: 6px 16px;
            border-radius: 20px;
            text-align: center;
            text-transform: uppercase;
        }

        .db-pill-success {
            background-color: rgba(31, 179, 152, 0.1);
            color: #1fb398;
            border: 1px solid rgba(31, 179, 152, 0.3);
        }

        .db-pill-warning {
            background-color: rgba(245, 158, 11, 0.1);
            color: #f59e0b;
            border: 1px solid rgba(245, 158, 11, 0.3);
        }

        /* BLOQUES DE MÉTRICAS */
        .db-metrics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-bottom: 8px;
        }

        .db-metric-card {
            background-color: #ffffff;
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 4px 20px rgba(6, 37, 66, 0.03);
            border: 1px solid rgba(6, 37, 66, 0.05);
            display: flex;
            flex-direction: column;
        }

        .db-metric-title {
            font-size: 12px;
            text-transform: uppercase;
            font-weight: 700;
            color: #666;
            letter-spacing: 0.5px;
        }

        .db-metric-value {
            font-size: 36px;
            font-weight: 800;
            color: #062542;
            margin: 8px 0;
        }

        .db-metric-subtitle {
            font-size: 12px;
            color: #888;
            font-weight: 500;
        }

        /* ESTILOS DE HAMBURGUER Y OVERLAY PARA MÓVIL/TABLET */
        .hamburger-btn {
            display: none;
            background: none;
            border: none;
            font-size: 22px;
            color: #062542;
            cursor: pointer;
            padding: 5px;
            margin-right: 15px;
            transition: color 0.2s;
            align-items: center;
            justify-content: center;
        }
        
        .hamburger-btn:hover {
            color: #1fb398;
        }

        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background-color: rgba(6, 37, 66, 0.5);
            backdrop-filter: blur(4px);
            z-index: 98;
            animation: fadeInOverlay 0.25s ease-out;
        }
        
        .sidebar-overlay.active {
            display: block;
        }

        @@keyframes fadeInOverlay {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        /* MEDIA QUERIES PARA LA RESPONSIVIDAD DEL PANEL GENERAL */
        @@media (max-width: 992px) {
            .hamburger-btn {
                display: flex;
            }

            .db-sidebar {
                position: fixed;
                left: 0;
                top: 0;
                bottom: 0;
                width: 280px;
                transform: translateX(-100%);
                transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                z-index: 99;
                box-shadow: 5px 0 25px rgba(6, 37, 66, 0.15);
            }

            .db-sidebar.open {
                transform: translateX(0);
            }

            .db-topbar {
                padding: 0 20px;
            }

            .db-view-body {
                padding: 20px;
                gap: 20px;
            }
        }

        @@media (max-width: 576px) {
            .db-topbar {
                height: 60px;
                padding: 0 15px;
            }

            .topbar-breadcrumb h2 {
                font-size: 15px;
            }

            .topbar-breadcrumb span {
                font-size: 10px;
            }

            .db-footer {
                flex-direction: column;
                height: auto;
                padding: 15px 20px;
                gap: 10px;
                text-align: center;
            }
        }
    </style>
</head>
<body class="db-layout">

    <!-- Overlay de oscurecimiento de fondo cuando se abre el sidebar en móviles/tablets -->
    <div id="sidebar-overlay-el" class="sidebar-overlay"></div>

    <!-- BARRA LATERAL (SIDEBAR) -->
    <aside class="db-sidebar">
        <!-- Logo y Nombre del Colegio -->
        <div class="sidebar-colegio">
            <div class="colegio-logo">GS</div>
            <div class="colegio-info">
                <h3>Colegio</h3>
                <p>Gotitas del saber</p>
            </div>
        </div>

        <!-- Banner de Perfil del Profesor -->
        <div class="sidebar-profile">
            <div class="profile-header-info">
                <div class="profile-avatar-circle">JP</div>
                <div class="profile-names">
                    <h4>Juan Pérez</h4>
                    <p>juan.perez@gmail.com</p>
                </div>
            </div>
            <span class="profile-role-badge">Profesor</span>
        </div>

        <!-- Menú Principal -->
        <span class="sidebar-menu-title">Menú Principal</span>
        <nav class="sidebar-nav-list">
            <!-- 
              * Enlaces dinámicos conectados usando tag helpers de ASP.NET MVC.
              * Usamos código JavaScript/C# en cada vista para alternar la clase "active".
             -->
            <a id="nav-inicio" asp-controller="Dashboard" asp-action="Profesor" class="db-nav-item">
                <i class="fa-solid fa-house"></i> Inicio
            </a>
            <a id="nav-cursos" asp-controller="Dashboard" asp-action="Cursos" class="db-nav-item">
                <i class="fa-solid fa-book"></i> Cursos
            </a>
            <a id="nav-estudiantes" asp-controller="Dashboard" asp-action="Estudiantes" class="db-nav-item">
                <i class="fa-solid fa-users"></i> Estudiantes
            </a>
            <a id="nav-boletines" asp-controller="Dashboard" asp-action="Boletines" class="db-nav-item">
                <i class="fa-solid fa-bullhorn"></i> Boletines
            </a>
            <a id="nav-calificaciones" asp-controller="Dashboard" asp-action="Calificaciones" class="db-nav-item">
                <i class="fa-solid fa-graduation-cap"></i> Calificaciones
            </a>
            <a id="nav-perfil" asp-controller="Dashboard" asp-action="Perfil" class="db-nav-item">
                <i class="fa-solid fa-user"></i> Mi perfil
            </a>
        </nav>

        <!-- Botón de Salida -->
        <div class="sidebar-footer">
            <a asp-controller="Home" asp-action="Index" class="btn-cerrar-sesion">
                <i class="fa-solid fa-right-from-bracket"></i> Cerrar sesión
            </a>
        </div>
    </aside>

    <!-- CUERPO PRINCIPAL -->
    <div class="db-main-panel">
        <!-- BARRA SUPERIOR (TOPBAR) -->
        <header class="db-topbar">
            <div style="display: flex; align-items: center;">
                <!-- Botón de hamburguesa responsivo -->
                <button id="hamburger-menu-btn" class="hamburger-btn" title="Menú">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <div class="topbar-breadcrumb">
                    <span>@ViewData["BreadcrumbParent"]</span>
                    <h2>@ViewData["BreadcrumbTitle"]</h2>
                </div>
            </div>
            
            <div class="topbar-actions">
                <button class="topbar-notifications-btn" title="Notificaciones">
                    <i class="fa-regular fa-bell"></i>
                    <span class="notifications-badge"></span>
                </button>
                <div class="topbar-user-avatar" onclick="location.href='@Url.Action("Perfil", "Dashboard")'" title="Ver Perfil">
                    JP
                </div>
            </div>
        </header>

        <!-- VISTA DE CONTENIDO RENDEREADO -->
        <main class="db-view-body">
            @RenderBody()
        </main>

        <!-- PIE DE PÁGINA (FOOTER) -->
        <footer class="db-footer">
            <span>© 2026 EDU-K · Plataforma educativa</span>
            <div class="db-footer-links">
                <a href="#">Soporte</a>
                <a href="#">Privacidad</a>
                <a href="#">Término</a>
            </div>
        </footer>
    </div>

    <!-- Scripts compartidos del dashboard -->
    <script src="~/js/Scripts.js" asp-append-version="true"></script>
    
    <!-- Script de control responsivo del Sidebar en móviles/tablets -->
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const hamburger = document.getElementById("hamburger-menu-btn");
            const sidebar = document.querySelector(".db-sidebar");
            const overlay = document.getElementById("sidebar-overlay-el");

            if (hamburger && sidebar && overlay) {
                hamburger.addEventListener("click", function() {
                    sidebar.classList.add("open");
                    overlay.classList.add("active");
                });

                overlay.addEventListener("click", function() {
                    sidebar.classList.remove("open");
                    overlay.classList.remove("active");
                });
            }
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
