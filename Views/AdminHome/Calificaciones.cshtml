@section Scripts {
<script>
    // Filtro de búsqueda en tabla
    document.getElementById('acad-search-input').addEventListener('input', function () {
        const val = this.value.toLowerCase();
        const rows = document.querySelectorAll('#acad-courses-table tbody tr');
        rows.forEach(row => {
            row.style.display = row.textContent.toLowerCase().includes(val) ? '' : 'none';
        });
    });

    // Filtro por grado
    document.getElementById('acad-filter-grado').addEventListener('change', function () {
        const val = this.value.toLowerCase();
        const rows = document.querySelectorAll('#acad-courses-table tbody tr');
        rows.forEach(row => {
            const grado = row.querySelector('.grado-badge')?.textContent.toLowerCase() ?? '';
            row.style.display = (val === 'todos los grados' || grado.includes(val)) ? '' : 'none';
        });
    });
</script>
}
