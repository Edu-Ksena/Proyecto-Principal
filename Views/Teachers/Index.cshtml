@model IEnumerable<mi_proyecto.Models.Teacher>
@{
    ViewData["Title"] = "Profesores";
    ViewData["SectionTitle"] = "PROFESORES";
}

<div class="content-header-row">
    <h2>LISTA DE PROFESORES</h2>
    <button class="primary-btn" onclick="openAddModal()">+ Agregar Profesor</button>
</div>

<!-- Contenedor de la Tabla -->
<div class="table-card">
    <table class="premium-table">
        <thead>
            <tr>
                <th style="width: 30%;">PROFESOR</th>
                <th style="width: 25%;">MATERIA</th>
                <th style="width: 25%;">TELÉFONO</th>
                <th style="width: 20%; text-align: center;">ACCIONES</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <div class="user-profile-cell">
                            <div class="badge-circle initial-badge" style="background-color: @item.BadgeColor">
                                @item.Initials
                            </div>
                            <span class="user-name">@item.Name</span>
                        </div>
                    </td>
                    <td>
                        <span class="materia-text">@item.Subject</span>
                    </td>
                    <td>
                        <span class="phone-text">@item.Phone</span>
                    </td>
                    <td>
                        <div class="actions-cell">
                            <!-- Botón Editar -->
                            <button class="action-btn edit-btn" onclick="openEditTeacherModal(@item.Id, '@Html.Raw(JavaScriptEncoder.Default.Encode(item.Name))', '@Html.Raw(JavaScriptEncoder.Default.Encode(item.Subject))', '@Html.Raw(JavaScriptEncoder.Default.Encode(item.Phone))')" title="Editar Profesor">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                    <path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                </svg>
                            </button>
                            <!-- Botón Eliminar -->
                            <button class="action-btn delete-btn" onclick="openDeleteModal(@item.Id, '@Html.Raw(JavaScriptEncoder.Default.Encode(item.Name))')" title="Eliminar Profesor">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                    <line x1="10" y1="11" x2="10" y2="17"></line>
                                    <line x1="14" y1="11" x2="14" y2="17"></line>
                                </svg>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- ========================================= MODAL AGREGAR PROFESOR ========================================= -->
<div id="addModal" class="modal-backdrop hidden">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Agregar Profesor</h3>
            <button class="close-modal-btn" onclick="closeAddModal()">&times;</button>
        </div>
        <form asp-action="Create" method="post">
            <div class="modal-body">
                <div class="form-group">
                    <label for="newName">Nombre Completo</label>
                    <input type="text" id="newName" name="Name" required placeholder="Ej: Juan Pérez" />
                </div>
                <div class="form-group">
                    <label for="newSubject">Materia</label>
                    <input type="text" id="newSubject" name="Subject" required placeholder="Ej: Matemáticas" />
                </div>
                <div class="form-group">
                    <label for="newPhone">Teléfono</label>
                    <input type="text" id="newPhone" name="Phone" required placeholder="Ej: 321 456 789" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cancel" onclick="closeAddModal()">Cancelar</button>
                <button type="submit" class="btn-submit">Guardar</button>
            </div>
        </form>
    </div>
</div>

<!-- ========================================= MODAL EDITAR PROFESOR ========================================= -->
<div id="editModal" class="modal-backdrop hidden">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Editar Profesor</h3>
            <button class="close-modal-btn" onclick="closeEditModal()">&times;</button>
        </div>
        <form asp-action="Edit" method="post">
            <div class="modal-body">
                <input type="hidden" id="editId" name="Id" />
                <div class="form-group">
                    <label for="editName">Nombre Completo</label>
                    <input type="text" id="editName" name="Name" required />
                </div>
                <div class="form-group">
                    <label for="editSubject">Materia</label>
                    <input type="text" id="editSubject" name="Subject" required />
                </div>
                <div class="form-group">
                    <label for="editPhone">Teléfono</label>
                    <input type="text" id="editPhone" name="Phone" required />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cancel" onclick="closeEditModal()">Cancelar</button>
                <button type="submit" class="btn-submit">Actualizar</button>
            </div>
        </form>
    </div>
</div>

<!-- ========================================= MODAL CONFIRMAR ELIMINACIÓN ========================================= -->
<div id="deleteModal" class="modal-backdrop hidden">
    <div class="modal-card modal-confirm">
        <div class="modal-header">
            <h3>Confirmar Eliminación</h3>
            <button class="close-modal-btn" onclick="closeDeleteModal()">&times;</button>
        </div>
        <form asp-action="Delete" method="post">
            <input type="hidden" id="deleteId" name="Id" />
            <div class="modal-body">
                <p>¿Estás seguro de que deseas eliminar al profesor <strong id="deleteTargetName"></strong>?</p>
                <p class="warning-text">Esta acción no se puede deshacer y desvinculará al profesor de cualquier curso asignado.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cancel" onclick="closeDeleteModal()">Cancelar</button>
                <button type="submit" class="btn-danger">Eliminar</button>
            </div>
        </form>
    </div>
</div>
