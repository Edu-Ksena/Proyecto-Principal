@model IEnumerable<mi_proyecto.Models.Course>
@{
    ViewData["Title"] = "Cursos";
    ViewData["SectionTitle"] = "CURSOS";
    var teachers = ViewBag.Teachers as IEnumerable<mi_proyecto.Models.Teacher> ?? new List<mi_proyecto.Models.Teacher>();
}

<div class="content-header-row">
    <h2>CURSOS ACTIVOS</h2>
    <button class="primary-btn" onclick="openAddModal()">+ Nuevo Curso</button>
</div>

<!-- Contenedor de la Tabla -->
<div class="table-card">
    <table class="premium-table">
        <thead>
            <tr>
                <th style="width: 30%;">PROFESORES ASIGNADOS</th>
                <th style="width: 30%;">CURSO</th>
                <th style="width: 20%;">ESTUDIANTES</th>
                <th style="width: 20%; text-align: center;">ACCIONES</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <div class="user-profile-cell">
                            <div class="badge-circle initial-badge" style="background-color: #5C6BC0">
                                @(string.IsNullOrEmpty(item.TeacherName) ? "SP" : string.Join("", item.TeacherName.Split(' ').Select(s => s[0])).ToUpper().Substring(0, Math.Min(2, item.TeacherName.Split(' ').Length)))
                            </div>
                            <span class="user-name">@item.TeacherName</span>
                        </div>
                    </td>
                    <td>
                        <span class="materia-text">@item.Name</span>
                    </td>
                    <td>
                        <span class="phone-text">@item.StudentsCount Estudiantes</span>
                    </td>
                    <td>
                        <div class="actions-cell">
                            <!-- Botón Editar -->
                            <button class="action-btn edit-btn" onclick="openEditCourseModal(@item.Id, '@Html.Raw(JavaScriptEncoder.Default.Encode(item.Name))', @item.TeacherId, @item.StudentsCount)" title="Editar Curso">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                    <path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                </svg>
                            </button>
                            <!-- Botón Eliminar -->
                            <button class="action-btn delete-btn" onclick="openDeleteModal(@item.Id, '@Html.Raw(JavaScriptEncoder.Default.Encode(item.Name))')" title="Eliminar Curso">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                    <line x1="10" y1="11" x2="10" y2="17"></line>
                                    <line x1="14" y1="11" x2="14" y2="17"></line>
                                </svg>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- ========================================= MODAL AGREGAR CURSO ========================================= -->
<div id="addModal" class="modal-backdrop hidden">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Agregar Nuevo Curso</h3>
            <button class="close-modal-btn" onclick="closeAddModal()">&times;</button>
        </div>
        <form asp-action="Create" method="post">
            <div class="modal-body">
                <div class="form-group">
                    <label for="newName">Nombre del Curso</label>
                    <input type="text" id="newName" name="Name" required placeholder="Ej: Noveno A-9ª" />
                </div>
                <div class="form-group">
                    <label for="newTeacher">Profesor Asignado</label>
                    <select id="newTeacher" name="TeacherId" class="custom-select" required>
                        <option value="">Selecciona un profesor...</option>
                        @foreach (var t in teachers)
                        {
                            <option value="@t.Id">@t.Name (@t.Subject)</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label for="newStudentsCount">Número de Estudiantes</label>
                    <input type="number" id="newStudentsCount" name="StudentsCount" required min="0" max="100" value="0" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cancel" onclick="closeAddModal()">Cancelar</button>
                <button type="submit" class="btn-submit">Guardar</button>
            </div>
        </form>
    </div>
</div>

<!-- ========================================= MODAL EDITAR CURSO ========================================= -->
<div id="editModal" class="modal-backdrop hidden">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Editar Curso</h3>
            <button class="close-modal-btn" onclick="closeEditModal()">&times;</button>
        </div>
        <form asp-action="Edit" method="post">
            <div class="modal-body">
                <input type="hidden" id="editId" name="Id" />
                <div class="form-group">
                    <label for="editName">Nombre del Curso</label>
                    <input type="text" id="editName" name="Name" required />
                </div>
                <div class="form-group">
                    <label for="editTeacher">Profesor Asignado</label>
                    <select id="editTeacher" name="TeacherId" class="custom-select" required>
                        @foreach (var t in teachers)
                        {
                            <option value="@t.Id">@t.Name (@t.Subject)</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label for="editStudentsCount">Número de Estudiantes</label>
                    <input type="number" id="editStudentsCount" name="StudentsCount" required min="0" max="100" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cancel" onclick="closeEditModal()">Cancelar</button>
                <button type="submit" class="btn-submit">Actualizar</button>
            </div>
        </form>
    </div>
</div>

<!-- ========================================= MODAL CONFIRMAR ELIMINACIÓN ========================================= -->
<div id="deleteModal" class="modal-backdrop hidden">
    <div class="modal-card modal-confirm">
        <div class="modal-header">
            <h3>Confirmar Eliminación</h3>
            <button class="close-modal-btn" onclick="closeDeleteModal()">&times;</button>
        </div>
        <form asp-action="Delete" method="post">
            <input type="hidden" id="deleteId" name="Id" />
            <div class="modal-body">
                <p>¿Estás seguro de que deseas eliminar el curso <strong id="deleteTargetName"></strong>?</p>
                <p class="warning-text">Esta acción eliminará el curso y liberará las asignaciones de horarios.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-cancel" onclick="closeDeleteModal()">Cancelar</button>
                <button type="submit" class="btn-danger">Eliminar</button>
            </div>
        </form>
    </div>
</div>
