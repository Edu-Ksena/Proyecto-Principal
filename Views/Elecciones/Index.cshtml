@{
    // Título y asignaciones para el diseño
    ViewData["Title"] = "Módulo Electoral";
    ViewData["ActivePage"] = "Elecciones";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<!--
  Cambios realizados:
  - Reemplazados los emojis decorativos por iconos inline Lucide:
    - Urna/votación: "check-square"
    - Avatar + añadir: "user-plus"
    - Casilla marcada: "check-square" (en tarjetas)
    - Gráfica: "bar-chart" (representación de resultados)
    - Objetivo/propuesta: "target"
  - Todos los textos permanecen en español y se añadieron comentarios explicativos.
-->

<!-- Título del Módulo Electoral de acuerdo al mockup -->
<div class="page-header" style="margin-bottom: 20px;">
    <div>
        <span style="font-size: 11px; font-weight: 700; color: var(--text-muted); letter-spacing: 0.05em; text-transform: uppercase;">Elecciones</span>
        <h1 class="page-title" style="margin-top: 4px;">Módulo Electoral</h1>
    </div>
    <div class="page-badge">LA</div>
</div>

@if (Context.Request.Query["votoRegistrado"] == "true")
{
    <div class="alert alert-success" style="padding: 16px 20px; margin-bottom: 24px; border-left: 5px solid var(--success); box-shadow: var(--shadow); background: #f0fdf4; border: 1px solid #86efac; border-radius: var(--radius); display: flex; align-items: center; gap: 14px;">
        <!-- Icono check-circle grande y animado -->
        <div style="width: 38px; height: 38px; border-radius: 50%; background: var(--success-bg); color: var(--success); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 18px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width: 20px; height: 20px;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <div style="flex: 1;">
            <strong style="color: var(--success); font-size: 14px; display: block; margin-bottom: 2px;">¡Voto registrado exitosamente!</strong>
            <span style="color: var(--text-secondary); font-size: 12px;">Tu participación en el proceso electoral ha sido confirmada y sellada en el sistema. Gracias por ejercer tu deber democrático estudiantil.</span>
        </div>
        <button onclick="this.parentElement.remove()" style="background: transparent; border: none; font-size: 18px; color: var(--text-muted); cursor: pointer; padding: 4px; display: flex; align-items: center; justify-content: center; opacity: 0.7; transition: opacity 0.2s;" onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=0.7">×</button>
    </div>
}

<!-- 1. GRAN BANNER DE CONVOCATORIA ACTIVA (FONDO AZUL CON GRADIENTE E ICONO DE VOTACIÓN) -->
<div class="card" style="background: linear-gradient(135deg, var(--primary), var(--primary-light)); border: none; color: #fff; padding: 24px; margin-bottom: 24px; position: relative; overflow: hidden; border-radius: var(--radius);">
    <!-- Decoración de fondo premium -->
    <div style="position: absolute; right: -20px; bottom: -20px; opacity: 0.1; width: 180px; height: 180px; background: #fff; border-radius: 50%;"></div>
    
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; position: relative; z-index: 2;">
        <div>
            <!-- Badge dorado de convocatoria activa -->
            <span style="font-size: 10px; font-weight: 700; background: var(--accent); color: var(--primary); padding: 3px 10px; border-radius: 20px; text-transform: uppercase; letter-spacing: 0.05em;">Convocatoria Activa</span>
            
            <h2 style="font-family: var(--font-serif); font-size: 26px; font-weight: 700; margin: 10px 0 4px; color: #fff;">Elecciones estudiantiles 2026</h2>
            <p style="font-size: 13px; opacity: 0.9; margin-bottom: 16px;">Votación abierta - Registramiento estudiantil</p>
            
            <!-- Fechas de la convocatoria -->
            <div style="display: flex; gap: 24px; flex-wrap: wrap;">
                <div>
                    <span style="font-size: 11px; opacity: 0.7; display: block; text-transform: uppercase;">Fecha de inicio</span>
                    <strong style="font-size: 13px;">15 mar. 2026</strong>
                </div>
                <div>
                    <span style="font-size: 11px; opacity: 0.7; display: block; text-transform: uppercase;">Cierra el</span>
                    <strong style="font-size: 13px;">25 mar. 2026</strong>
                </div>
            </div>
        </div>
        
        <!-- Botón de acción naranja y caja de votación -->
        <div style="display: flex; align-items: center; gap: 20px; flex-wrap: wrap;">
            <!-- Icono decorativo de urna electoral (check-square) -->
            <div style="width: 64px; height: 64px; border-radius: 50%; background: rgba(255, 255, 255, 0.1); display: flex; align-items: center; justify-content: center; font-size: 28px;">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-check-square" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M9 12l2 2l4 -4"/>
                    <path d="M4 4h16v16h-16z"/>
                </svg>
            </div>
            
            <!-- Botón interactivo para ir a votar -->
            <a asp-controller="Elecciones" asp-action="Votar" class="btn" style="background: var(--accent); color: var(--primary); font-weight: 700; padding: 12px 24px; font-size: 13px; box-shadow: 0 4px 12px rgba(232, 160, 32, 0.3); border: none; border-radius: var(--radius-sm); transition: background 0.2s;">
                Votación abierta
            </a>
        </div>
    </div>
</div>

<!-- 2. GRID DE ACCESOS DIRECTOS PRINCIPALES (3 COLUMNAS RESPONSIVAS) -->
<div class="grid-3" style="margin-bottom: 28px; gap: 18px;">
    <!-- Acceso 1: Inscripción de Candidatos -->
    <div class="card" style="display: flex; flex-direction: column; justify-content: space-between; padding: 20px; transition: transform 0.2s, box-shadow 0.2s; border-radius: var(--radius);">
        <div>
            <!-- Icono con fondo azul claro (user-plus) -->
            <div style="width: 44px; height: 44px; border-radius: var(--radius-sm); background: #f0f4ff; display: flex; align-items: center; justify-content: center; font-size: 20px; color: var(--primary); margin-bottom: 16px;">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <line x1="19" x2="19" y1="8" y2="14" />
                    <line x1="22" x2="16" y1="11" y2="11" />
                </svg>
            </div>
            <h3 style="font-size: 15px; font-weight: 700; color: var(--primary); margin-bottom: 8px;">Inscripción de Candidatos</h3>
            <p style="font-size: 12px; color: var(--text-secondary); line-height: 1.4; margin-bottom: 16px;">Postúlate como candidato en las elecciones estudiantiles activas</p>
        </div>
        <a asp-controller="Elecciones" asp-action="Inscripcion" style="font-size: 12px; font-weight: 600; color: var(--primary-light); display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
            Inscribirme &rarr;
        </a>
    </div>

    <!-- Acceso 2: Votación Activa -->
    <div class="card" style="display: flex; flex-direction: column; justify-content: space-between; padding: 20px; transition: transform 0.2s, box-shadow 0.2s; border-radius: var(--radius);">
        <div>
            <!-- Icono con fondo verde claro (check-square) -->
            <div style="width: 44px; height: 44px; border-radius: var(--radius-sm); background: var(--success-bg); display: flex; align-items: center; justify-content: center; font-size: 20px; color: var(--success); margin-bottom: 16px;">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-check-square" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M9 12l2 2l4 -4"/>
                    <path d="M4 4h16v16h-16z"/>
                </svg>
            </div>
            <h3 style="font-size: 15px; font-weight: 700; color: var(--primary); margin-bottom: 8px;">Votación</h3>
            <p style="font-size: 12px; color: var(--text-secondary); line-height: 1.4; margin-bottom: 16px;">Emite tu voto en los procesos electorales activos de forma segura</p>
        </div>
        <a asp-controller="Elecciones" asp-action="Votar" style="font-size: 12px; font-weight: 600; color: var(--success); display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
            Votar ahora &rarr;
        </a>
    </div>

    <!-- Acceso 3: Resultados Electorales -->
    <div class="card" style="display: flex; flex-direction: column; justify-content: space-between; padding: 20px; transition: transform 0.2s, box-shadow 0.2s; border-radius: var(--radius);">
        <div>
            <!-- Icono de gráfica (bar-chart) -->
            <div style="width: 44px; height: 44px; border-radius: var(--radius-sm); background: #f5f0ff; display: flex; align-items: center; justify-content: center; font-size: 20px; color: #8b5cf6; margin-bottom: 16px;">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-bar-chart" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M12 20v-16"/>
                    <path d="M18 20v-8"/>
                    <path d="M6 20v-4"/>
                </svg>
            </div>
            <h3 style="font-size: 15px; font-weight: 700; color: var(--primary); margin-bottom: 8px;">Resultados</h3>
            <p style="font-size: 12px; color: var(--text-secondary); line-height: 1.4; margin-bottom: 16px;">Consulta los resultados certificados de las elecciones del colegio</p>
        </div>
        <a asp-controller="Elecciones" asp-action="Resultados" style="font-size: 12px; font-weight: 600; color: #8b5cf6; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
            Ver resultados &rarr;
        </a>
    </div>
</div>

<!-- 3. SECCIÓN: CARGOS DISPONIBLES (GRID DE 2 COLUMNAS) -->
<div class="card" style="margin-bottom: 24px; border-radius: var(--radius); padding: 20px;">
    <div style="margin-bottom: 16px;">
        <h3 style="font-size: 16px; font-weight: 700; color: var(--primary); margin-bottom: 2px;">Cargos disponibles</h3>
        <p style="font-size: 12px; color: var(--text-muted);">Convocatoria 2026</p>
    </div>
    
    <div class="grid-2" style="gap: 16px;">
        @{
            var cargosConvocados = new[]
            {
                new { Nombre = "Personero Estudiantil", Grado = "11°", Desc = "Representa a todos los estudiantes ante el Consejo Directivo.", Puestos = "1 puesto" },
                new { Nombre = "Representante de Grupo", Grado = "Todos", Desc = "Vocero del salón para liderar proyectos académicos y de convivencia.", Puestos = "1 puesto" },
                new { Nombre = "Comité de Convivencia", Grado = "10-11°", Desc = "Promueve el ambiente escolar sano y la resolución de conflictos.", Puestos = "3 puestos" },
                new { Nombre = "Contralor Estudiantil", Grado = "11°", Desc = "Vigila el uso de los recursos del colegio y el presupuesto participativo.", Puestos = "1 puesto" }
            };
        }

        @foreach (var cargo in cargosConvocados)
        {
            <!-- Tarjeta de cargo escolar individual -->
            <div style="border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 16px; display: flex; flex-direction: column; justify-content: space-between; background: var(--surface-2); min-height: 120px;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; margin-bottom: 8px;">
                    <div>
                        <h4 style="font-size: 14px; font-weight: 700; color: var(--primary); margin-bottom: 4px;">@cargo.Nombre</h4>
                        <p style="font-size: 12px; color: var(--text-secondary); line-height: 1.3;">@cargo.Desc</p>
                    </div>
                    <!-- Badge del grado habilitado -->
                    <span class="tag" style="background: var(--secondary); color: var(--primary); font-weight: 600; padding: 2px 8px; border-radius: 4px; font-size: 11px; white-space: nowrap;">@cargo.Grado</span>
                </div>
                
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px; border-top: 1px dashed var(--border); padding-top: 10px;">
                    <span style="font-size: 11px; color: var(--text-muted); font-weight: 500;">@cargo.Puestos</span>
                    <a asp-controller="Elecciones" asp-action="Inscripcion" style="font-size: 11px; font-weight: 600; color: var(--primary-light); text-decoration: none; display: inline-flex; align-items: center; gap: 2px;">
                        Postularme &rarr;
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<!-- 4. SECCIÓN: CANDIDATOS INSCRITOS (GRID DE 2 COLUMNAS) -->
<div class="card" style="border-radius: var(--radius); padding: 20px;">
    <div style="margin-bottom: 16px;">
        <h3 style="font-size: 16px; font-weight: 700; color: var(--primary); margin-bottom: 2px;">Candidatos inscritos</h3>
        <p style="font-size: 12px; color: var(--text-muted);">Personero Estudiantil 2026</p>
    </div>
    
    <div class="grid-2" style="gap: 16px;">
        <!-- Candidato 1: Santiago Muñoz -->
        <div style="border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 16px; display: flex; align-items: center; gap: 16px; background: var(--surface);">
            <!-- Avatar y número de lista -->
            <div style="position: relative;">
                <div style="width: 52px; height: 52px; border-radius: 50%; background: linear-gradient(135deg, var(--primary), var(--primary-light)); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 16px;">
                    SM
                </div>
                <div style="position: absolute; top: -4px; left: -4px; width: 22px; height: 22px; border-radius: 50%; background: var(--primary); color: #fff; font-size: 10px; font-weight: 700; display: flex; align-items: center; justify-content: center; border: 2px solid #fff;">
                    01
                </div>
            </div>
            
            <div style="flex: 1;">
                <span style="font-size: 10px; font-weight: 600; color: var(--text-muted); display: block; text-transform: uppercase;">Lista 01</span>
                <strong style="font-size: 14px; color: var(--primary); display: block; margin: 1px 0 2px;">Santiago Muñoz</strong>
                <span style="font-size: 11px; color: var(--text-secondary); display: block;">Grado 11° A</span>
                <p style="font-size: 12px; color: var(--primary); font-weight: 500; margin-top: 6px; display: inline-flex; align-items: center; gap: 4px;">
                    <!-- Icono "target" inline para indicar propuesta/objetivo -->
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-target" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <circle cx="12" cy="12" r="10"/>
                        <circle cx="12" cy="12" r="6"/>
                        <circle cx="12" cy="12" r="2"/>
                    </svg>
                    Propuesta: <span style="font-weight: 400; color: var(--text-secondary);">Deporte y bienestar</span>
                </p>
            </div>
        </div>

        <!-- Candidato 2: Valentina Torres -->
        <div style="border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 16px; display: flex; align-items: center; gap: 16px; background: var(--surface);">
            <!-- Avatar y número de lista -->
            <div style="position: relative;">
                <div style="width: 52px; height: 52px; border-radius: 50%; background: linear-gradient(135deg, #0b69c4, #3b82f6); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 16px;">
                    VT
                </div>
                <div style="position: absolute; top: -4px; left: -4px; width: 22px; height: 22px; border-radius: 50%; background: #0b69c4; color: #fff; font-size: 10px; font-weight: 700; display: flex; align-items: center; justify-content: center; border: 2px solid #fff;">
                    02
                </div>
            </div>
            
            <div style="flex: 1;">
                <span style="font-size: 10px; font-weight: 600; color: var(--text-muted); display: block; text-transform: uppercase;">Lista 02</span>
                <strong style="font-size: 14px; color: var(--primary); display: block; margin: 1px 0 2px;">Valentina Torres</strong>
                <span style="font-size: 11px; color: var(--text-secondary); display: block;">Grado 10° B</span>
                <p style="font-size: 12px; color: var(--primary); font-weight: 500; margin-top: 6px; display: inline-flex; align-items: center; gap: 4px;">
                    <!-- Icono "target" inline para indicar propuesta/objetivo -->
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-target" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <circle cx="12" cy="12" r="10"/>
                        <circle cx="12" cy="12" r="6"/>
                        <circle cx="12" cy="12" r="2"/>
                    </svg>
                    Propuesta: <span style="font-weight: 400; color: var(--text-secondary);">Tecnología y cultura</span>
                </p>
            </div>
        </div>
    </div>
</div>
