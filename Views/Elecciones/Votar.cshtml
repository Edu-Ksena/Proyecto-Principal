@{
    ViewData["Title"] = "Votación";
    ViewData["ActivePage"] = "Elecciones";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Votación Estudiantil 2026</h1>
        <p class="page-subtitle">Viernes, 20 de marzo de 2026</p>
    </div>
    <div class="page-badge">LA</div>
</div>

<!-- STEPPER -->
<div style="display:flex;align-items:center;gap:0;margin-bottom:28px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px 24px;flex-wrap:wrap;gap:12px;">
    @{
        var steps = new[] { "Seleccionar cargo", "Elegir candidato", "Confirmar voto", "Voto emitido" };
        int activeStep = 2;
    }
    @for (int i = 0; i < steps.Length; i++)
    {
        bool isDone   = i < activeStep - 1;
        bool isCurrent = i == activeStep - 1;
        <div style="display:flex;align-items:center;gap:8px;@(i < steps.Length - 1 ? "flex:1;" : "")">
            <div style="width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;flex-shrink:0;background:@(isDone ? "var(--success)" : isCurrent ? "var(--primary)" : "var(--border)");color:@(isDone || isCurrent ? "#fff" : "var(--text-muted)");">
                @(isDone ? "✓" : (i + 1).ToString())
            </div>
            <span style="font-size:12px;font-weight:@(isCurrent ? "600" : "400");color:@(isCurrent ? "var(--primary)" : isDone ? "var(--success)" : "var(--text-muted)");">@steps[i]</span>
            @if (i < steps.Length - 1)
            {
                <div style="flex:1;height:1px;background:@(isDone ? "var(--success)" : "var(--border)");margin:0 8px;"></div>
            }
        </div>
    }
</div>

<div class="card" style="margin-bottom:20px;">
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px;">
        <div style="font-weight:600;font-size:14px;">Votando para el cargo: <span style="color:var(--primary);">Personero Estudiantil 2026</span></div>
        <div style="width:18px;height:18px;border-radius:50%;background:var(--border);display:flex;align-items:center;justify-content:center;font-size:10px;cursor:help;color:var(--text-muted);" title="Selecciona un candidato y confirma tu voto. Esta acción no se puede deshacer.">?</div>
    </div>
    <p style="font-size:12px;color:var(--text-muted);margin-bottom:20px;">Selecciona un candidato y confirma tu voto. Esta acción no se puede deshacer.</p>

    <div class="card-title">Candidatos inscritos</div>
    <p style="font-size:12px;color:var(--text-muted);margin-bottom:16px;">Haz clic en la tarjeta del candidato de tu preferencia para seleccionarlo</p>

    <!-- grid-3 se colapsa a 1 columna en móvil via CSS (@@media max-width:768px) -->
    <div class="grid-3" style="margin-bottom:20px;">

        <!-- CANDIDATO 1 - SELECCIONADO -->
        <div class="candidate-card selected" onclick="selectCandidate(this, 'Santiago Muñoz · Lista 01')">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
                <span style="font-size:10px;font-weight:700;color:var(--accent);background:#fffdf5;border:1px solid var(--accent);border-radius:20px;padding:2px 10px;">✓ Candidato seleccionado</span>
                <div class="lista-badge">1</div>
            </div>
            <div class="candidate-avatar" style="background:linear-gradient(135deg,var(--primary),var(--primary-light));">SM</div>
            <div style="text-align:center;margin-top:10px;">
                <div style="font-weight:700;font-size:15px;">Santiago Muñoz</div>
                <div style="font-size:12px;color:var(--text-muted);margin-top:2px;">Grado 11° A · Jornada Mañana</div>
            </div>
        </div>

        <!-- CANDIDATO 2 -->
        <div class="candidate-card" onclick="selectCandidate(this, 'Valentina Torres · Lista 02')">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
                <span style="font-size:10px;color:var(--text-muted);background:var(--surface-2);border:1px solid var(--border);border-radius:20px;padding:2px 10px;">Haz clic para seleccionar</span>
                <div class="lista-badge" style="background:#8b5cf6;">2</div>
            </div>
            <div class="candidate-avatar" style="background:linear-gradient(135deg,#8b5cf6,#6d28d9);">VT</div>
            <div style="text-align:center;margin-top:10px;">
                <div style="font-weight:700;font-size:15px;">Valentina Torres</div>
                <div style="font-size:12px;color:var(--text-muted);margin-top:2px;">Grado 10° B · Jornada Mañana</div>
            </div>
        </div>

        <!-- VOTO EN BLANCO -->
        <div class="candidate-card" onclick="selectCandidate(this, 'Voto en Blanco')">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
                <span style="font-size:10px;color:var(--text-muted);background:var(--surface-2);border:1px solid var(--border);border-radius:20px;padding:2px 10px;">Haz clic para seleccionar</span>
                <div class="lista-badge" style="background:var(--text-muted);">—</div>
            </div>
            <div class="candidate-avatar" style="background:var(--border);color:var(--text-muted);">✗</div>
            <div style="text-align:center;margin-top:10px;">
                <div style="font-weight:700;font-size:15px;color:var(--text-muted);">Voto en Blanco</div>
                <div style="font-size:12px;color:var(--text-muted);margin-top:2px;">Ninguno de los anteriores</div>
            </div>
        </div>

    </div>

    <!-- SELECCIÓN ACTUAL -->
    <div id="selection-info" style="background:var(--surface-2);border:1px solid var(--border);border-radius:var(--radius-sm);padding:12px 16px;font-size:13px;margin-bottom:16px;">
        Candidato seleccionado: <strong>Santiago Muñoz · Lista 01 · Personero Estudiantil</strong>
    </div>

    <div class="alert alert-warning">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;flex-shrink:0;"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        Recuerda: una vez confirmado, tu voto <strong>no podrá modificarse</strong>.
    </div>

    <div style="display:flex;justify-content:space-between;margin-top:20px;gap:10px;flex-wrap:wrap;">
        <a asp-controller="Elecciones" asp-action="Index" class="btn btn-outline">← Volver</a>
        <button class="btn btn-accent" onclick="showConfirmModal()">Confirmar voto →</button>
    </div>
</div>

<!-- MODAL CONFIRMAR -->
<div id="confirm-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:100;align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:var(--radius);padding:32px;max-width:380px;width:90%;box-shadow:var(--shadow-lg);">
        <h3 style="font-size:18px;font-weight:700;color:var(--primary);margin-bottom:4px;">Confirmar tu voto</h3>
        <p style="font-size:12px;color:var(--danger);margin-bottom:20px;">Esta acción es definitiva e irreversible</p>

        <p style="font-size:13px;color:var(--text-muted);margin-bottom:16px;">Estás a punto de votar por:</p>

        <div style="display:flex;align-items:center;gap:14px;background:var(--surface-2);border-radius:var(--radius-sm);padding:16px;border:1px solid var(--border);margin-bottom:20px;">
            <div class="lista-badge" style="width:36px;height:36px;font-size:14px;">1</div>
            <div>
                <div style="font-weight:700;font-size:16px;">Santiago Muñoz</div>
                <div style="font-size:12px;color:var(--text-muted);">Grado 11° A</div>
                <div style="font-size:12px;color:var(--primary);font-weight:500;margin-top:2px;">Personero Estudiantil</div>
            </div>
        </div>

        <p style="font-size:12px;color:var(--text-muted);margin-bottom:20px;">Una vez emitido, el voto no puede ser cambiado ni anulado.</p>

        <div style="display:flex;gap:10px;">
            <button class="btn btn-outline" style="flex:1;" onclick="hideConfirmModal()">Cancelar</button>
            <a asp-controller="Elecciones" asp-action="Index" asp-route-votoRegistrado="true" class="btn btn-accent" style="flex:1;justify-content:center;">Sí, emitir voto</a>
        </div>
    </div>
</div>

@section Scripts {
<script>
function selectCandidate(card, name) {
    document.querySelectorAll('.candidate-card').forEach(c => {
        c.classList.remove('selected');
        const badge = c.querySelector('span');
        if (badge) {
            badge.textContent = 'Haz clic para seleccionar';
            badge.style.cssText = 'font-size:10px;color:var(--text-muted);background:var(--surface-2);border:1px solid var(--border);border-radius:20px;padding:2px 10px;';
        }
    });
    card.classList.add('selected');
    const badge = card.querySelector('span');
    if (badge) {
        badge.textContent = '✓ Candidato seleccionado';
        badge.style.cssText = 'font-size:10px;font-weight:700;color:var(--accent);background:#fffdf5;border:1px solid var(--accent);border-radius:20px;padding:2px 10px;';
    }
    document.getElementById('selection-info').innerHTML = 'Candidato seleccionado: <strong>' + name + ' · Personero Estudiantil</strong>';
}

function showConfirmModal() {
    const modal = document.getElementById('confirm-modal');
    modal.style.display = 'flex';
}

function hideConfirmModal() {
    const modal = document.getElementById('confirm-modal');
    modal.style.display = 'none';
}
</script>
}
