@model IEnumerable<mi_proyecto.Models.VotingEvent>
@{
    ViewData["Title"] = "Votaciones";
    ViewData["SectionTitle"] = "Gestión de Votaciones";
    var candidatesMap = ViewBag.CandidatesMap as Dictionary<int, List<mi_proyecto.Models.VotingCandidate>>;
}

<div class="page-header">
    <div class="header-content">
        <h1>Votaciones y Elecciones</h1>
        <p>Administra los periodos de votación y gestiona los participantes.</p>
    </div>
    <div class="header-actions">
        <button class="btn btn-primary" onclick="openModal('addVotingModal')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Nuevo Periodo
        </button>
    </div>
</div>

<div class="voting-grid">
    @foreach(var vEvent in Model)
    {
        var statusClass = vEvent.Status == "En Curso" ? "status-active" : (vEvent.Status == "Programada" ? "status-pending" : "status-finished");
        var candidates = candidatesMap != null && candidatesMap.ContainsKey(vEvent.Id) ? candidatesMap[vEvent.Id] : new List<mi_proyecto.Models.VotingCandidate>();
        
        <div class="voting-card">
            <div class="voting-header">
                <div class="voting-title-area">
                    <h3>@vEvent.Title</h3>
                    <span class="badge @statusClass">@vEvent.Status</span>
                </div>
                <div class="voting-actions">
                    <form method="post" action="@Url.Action("DeleteEvent", "Voting")" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@vEvent.Id" />
                        <button type="submit" class="btn-icon btn-danger" onclick="return confirm('¿Eliminar esta votación?');">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                        </button>
                    </form>
                </div>
            </div>
            <div class="voting-body">
                <div class="voting-dates">
                    <div class="date-item">
                        <span class="date-label">Inicio:</span>
                        <span class="date-value">@vEvent.StartDate.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div class="date-item">
                        <span class="date-label">Fin:</span>
                        <span class="date-value">@vEvent.EndDate.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                </div>
                <div class="voting-candidates-section">
                    <div class="section-header">
                        <h4>Candidatos Participantes (@candidates.Count)</h4>
                        <button class="btn btn-secondary btn-sm" onclick="openAddCandidateModal(@vEvent.Id, '@vEvent.Title.Replace("'", "\\'")')">
                            + Agregar
                        </button>
                    </div>
                    <div class="candidates-list">
                        @if(candidates.Any())
                        {
                            @foreach(var c in candidates)
                            {
                                <div class="candidate-item">
                                    <div class="candidate-info">
                                        <strong>@c.Name</strong>
                                        <p>@c.Proposal</p>
                                    </div>
                                    <div class="candidate-stats">
                                        <span class="votes-badge">@c.VotesCount Votos</span>
                                        <form method="post" action="@Url.Action("DeleteCandidate", "Voting")" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <button type="submit" class="btn-icon btn-danger btn-sm" onclick="return confirm('¿Eliminar candidato?');">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">No hay candidatos registrados.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal: Agregar Votación -->
<div id="addVotingModal" class="modal-overlay">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Nuevo Periodo de Votación</h2>
            <button class="close-btn" onclick="closeModal('addVotingModal')">&times;</button>
        </div>
        <div class="modal-body">
            <form method="post" action="@Url.Action("CreateEvent", "Voting")">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label for="Title">Título de Votación</label>
                    <input type="text" id="Title" name="Title" class="form-control" required placeholder="Ej. Personero 2026" />
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="StartDate">Fecha y Hora de Inicio</label>
                        <input type="datetime-local" id="StartDate" name="StartDate" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label for="EndDate">Fecha y Hora de Fin</label>
                        <input type="datetime-local" id="EndDate" name="EndDate" class="form-control" required />
                    </div>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('addVotingModal')">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Crear Votación</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Agregar Candidato -->
<div id="addCandidateModal" class="modal-overlay">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Agregar Candidato</h2>
            <button class="close-btn" onclick="closeModal('addCandidateModal')">&times;</button>
        </div>
        <div class="modal-body">
            <p id="candidateModalEventTitle" style="color: var(--text-muted); margin-bottom: 15px; font-weight: 500;"></p>
            <form method="post" action="@Url.Action("AddCandidate", "Voting")">
                @Html.AntiForgeryToken()
                <input type="hidden" id="VotingEventId" name="VotingEventId" value="" />
                <div class="form-group">
                    <label for="Name">Nombre del Participante</label>
                    <input type="text" id="Name" name="Name" class="form-control" required />
                </div>
                <div class="form-group">
                    <label for="Proposal">Propuesta o Lema</label>
                    <textarea id="Proposal" name="Proposal" class="form-control" rows="3" required></textarea>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('addCandidateModal')">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Registrar</button>
                </div>
            </form>
        </div>
    </div>
</div>
