                </td>
                <!-- JUEVES: Ed. Física 9–10 -->
                <td>
                    <div class="class-block" style="background:#fdf2f8;border-color:#f9a8d4;">
                        <span class="class-name" style="color:#9d174d;">Ed. Física</span>
                        <span class="class-detail">9:00 – 10:00 · Cancha</span>
                    </div>
                </td>
                <!-- VIERNES: Inglés 8:30–10 -->
                <td rowspan="1">
                    <div class="class-block" style="background:#f5f0ff;border-color:#c4b5fd;">
                        <span class="class-name" style="color:#5b21b6;">Inglés</span>
                        <span class="class-detail">8:30 – 10:00</span>
                        <span class="class-detail">Prof. C. Pinto · Aula 201</span>
                    </div>
                </td>
            </tr>

            <!-- DESCANSO 10:00 -->
            <tr class="break-row">
                <td class="time-col" style="color:var(--warning);font-size:11px;">10:00</td>
                <td colspan="5">
                    <!-- Icono "coffee" inline para descanso -->
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M18 8h1a3 3 0 0 1 0 6h-1"></path>
                        <path d="M2 8h16v7a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V8z"></path>
                        <line x1="6" y1="3" x2="6" y2="5"></line>
                        <line x1="10" y1="3" x2="10" y2="5"></line>
                    </svg>
                    Descanso · 10:00 – 10:30
                </td>
            </tr>

            <!-- BLOQUE 10:30 -->
            <tr>
                <td class="time-col">10:30</td>
                <!-- LUNES: Inglés 10:30–11:30 -->
                <td>
                    <div class="class-block" style="background:#f5f0ff;border-color:#c4b5fd;">
