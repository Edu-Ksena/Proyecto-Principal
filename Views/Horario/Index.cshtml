                        <span class="class-name" style="color:var(--success);">Tecnología</span>
                        <span class="class-detail">10:30 – 11:30 · Sala Sist.</span>
                    </div>
                </td>
                <!-- MIÉRCOLES: Ciencias Nat. 10:30–12:30 (rowspan 2) -->
                <td rowspan="2">
                    <div class="class-block" style="background:#f0fdf4;border-color:#86efac;">
                        <span class="class-name" style="color:var(--success);">Ciencias Nat.</span>
                        <span class="class-detail">10:30 – 12:30</span>
                        <span class="class-detail">Prof. L. Gómez · Lab. 1</span>
                    </div>
                </td>
                <!-- JUEVES: Filosofía 10:30–11:30 -->
                <td>
                    <div class="class-block" style="background:#fffbeb;border-color:#fde68a;">
                        <span class="class-name" style="color:#92400e;">Filosofía</span>
                        <span class="class-detail">10:30 – 11:30 · Aula 301</span>
                    </div>
                </td>
                <!-- VIERNES: Ciencias Nat. 10:30–12 (rowspan 2) -->
                <td rowspan="2">
                    <div class="class-block" style="background:#f0fdf4;border-color:#86efac;">
                        <span class="class-name" style="color:var(--success);">Ciencias Nat.</span>
                        <span class="class-detail">10:30 – 12:00</span>
                        <span class="class-detail">Prof. L. Gómez · Lab. 1</span>
                    </div>
                </td>
            </tr>

            <!-- BLOQUE 11:30 -->
            <tr>
                <td class="time-col">11:30</td>
                <!-- LUNES: Ed. Artística 11:30–12:30 -->
                <td>
                    <div class="class-block" style="background:#fef9c3;border-color:#fde047;">
                        <span class="class-name" style="color:#854d0e;">Ed. Artística</span>
                        <span class="class-detail">11:30 – 12:30 · Sala de Arte</span>
                    </div>
                </td>
                <!-- MARTES vacío -->
                <td><div style="height:40px;"></div></td>
                <!-- JUEVES vacío -->
                <td><div style="height:40px;"></div></td>
            </tr>

            <!-- ALMUERZO 12:30 -->
            <tr class="break-row">
                <td class="time-col" style="color:var(--warning);font-size:11px;">12:30</td>
                <td colspan="5">
                    <!-- Icono "coffee" inline (Almuerzo/pausa) -->
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M18 8h1a3 3 0 0 1 0 6h-1"></path>
                        <path d="M2 8h16v7a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V8z"></path>
                        <line x1="6" y1="3" x2="6" y2="5"></line>
                        <line x1="10" y1="3" x2="10" y2="5"></line>
                    </svg>
                    Almuerzo · 12:30 – 1:00
                </td>
            </tr>

            <!-- BLOQUE 1:00 -->
            <tr>
                <td class="time-col">1:00</td>
                <!-- LUNES: Historia 1–2 -->
                <td>
                    <div class="class-block" style="background:#fff7ed;border-color:#fed7aa;">
                        <span class="class-name" style="color:#c2410c;">Historia</span>
                        <span class="class-detail">1:00 – 2:00 · Aula 302</span>
                    </div>
                </td>
                <!-- MARTES vacío -->
                <td><div style="height:40px;"></div></td>
                <!-- MIÉRCOLES vacío -->
                <td><div style="height:40px;"></div></td>
                <!-- JUEVES: Tecnología 1–2 -->
                <td>
                    <div class="class-block" style="background:#f0fdf4;border-color:#86efac;">
                        <span class="class-name" style="color:var(--success);">Tecnología</span>
                        <span class="class-detail">1:00 – 2:00 · Sala Sist.</span>
                    </div>
                </td>
                <!-- VIERNES: Lengua Cast. 1–2 -->
                <td>
                    <div class="class-block" style="background:#fffbeb;border-color:#fde68a;">
                        <span class="class-name" style="color:#92400e;">Lengua Cast.</span>
                        <span class="class-detail">1:00 – 2:00 · Aula 205</span>
                    </div>
                </td>
            </tr>

            <!-- BLOQUE 2:00 -->
            <tr>
                <td class="time-col">2:00</td>
                <!-- MARTES: Ed. Física 2–3 -->
                <td><div style="height:40px;"></div></td>
                <td>
                    <div class="class-block" style="background:#fdf2f8;border-color:#f9a8d4;">
