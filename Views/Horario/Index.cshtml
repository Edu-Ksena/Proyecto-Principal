                </td>
                <!-- MIÉRCOLES vacío -->
                <td><div style="height:40px;"></div></td>
                <!-- JUEVES vacío -->
                <td><div style="height:40px;"></div></td>
                <!-- VIERNES: Ed. Artística 2–3 -->
                <td>
                    <div class="class-block" style="background:#fef9c3;border-color:#fde047;">
                        <span class="class-name" style="color:#854d0e;">Ed. Artística</span>
                        <span class="class-detail">2:00 – 3:00 · Sala de Arte</span>
