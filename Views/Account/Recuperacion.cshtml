@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- FUENTE -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <!-- ICONOS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <title>Recuperar contraseña | EDU-K</title>
    <link rel="stylesheet" href="~/css/Styles.css" asp-append-version="true">
</head>
<body class="recover-page">
    <!-- FONDO -->
    <div class="overlay"></div>

    <div class="recover-wrapper">
        <!-- IZQUIERDA -->
        <div class="recover-left">
            <img src="~/images/Logo.png" alt="Logo EDU-K" asp-append-version="true">
            <h1>EDU-K</h1>
            <p>
                GESTIÓN EDUCATIVA <br>
                AL ALCANCE DE UN CLICK
            </p>
        </div>

        <!-- DERECHA -->
        <div class="recover-right">
            <h2>RECUPERAR CONTRASEÑA</h2>
            <p class="recover-sub">
                Tranqui, todos olvidamos algo.
                Ingresa tu correo y te enviaremos instrucciones
                para recuperar tu contraseña.
            </p>
            <form class="recover-form">
                <label>CORREO ELECTRÓNICO</label>
                <div class="input-box">
                    <input type="email" placeholder="correo@email.com">
                </div>
                <button type="submit">
                    Enviar
                </button>
            </form>
            <a asp-controller="Account" asp-action="Login" class="back-login">
                <i class="fas fa-arrow-left"></i>
                Volver al inicio de sesión
            </a>
        </div>
    </div>
</body>
</html>
