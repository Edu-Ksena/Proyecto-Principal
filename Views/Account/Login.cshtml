@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | EDU-K</title>
    <link rel="stylesheet" href="~/css/Styles.css" asp-append-version="true">
</head>
<body class="login-page">
    <div class="login-wrapper">
        <a asp-controller="Home" asp-action="Index" class="back-btn">🡰</a>

        <!-- LADO IZQUIERDA -->
        <div class="login-left">
            <img src="~/images/Logo.png" alt="logo" asp-append-version="true">
            <h2>EDU-K</h2>
            <p>GESTIÓN EDUCATIVA<br>AL ALCANCE DE UN CLICK</p>
        </div>

        <!-- LADO DERECHA -->
        <div class="login-right">
            <h1>BIENVENIDO</h1>
            <form class="login-form" onsubmit="event.preventDefault(); validateLogin();">
                <label>USUARIO</label>
                <input type="text" id="username" placeholder="Usuario (admin, profe, est)" required style="text-transform: none;">

                <label>CONTRASEÑA</label>
                <input type="password" id="password" placeholder="********" required>

                <div id="error-message" style="color: #ff4a4a; margin-top: 10px; margin-bottom: 10px; font-weight: bold; display: none; text-align: center;">
                    Credenciales incorrectas
                </div>

                <button type="submit">Ingresar</button>
            </form>

            <script>
                function validateLogin() {
                    const user = document.getElementById('username').value.trim();
                    const pass = document.getElementById('password').value.trim();
                    const errorDiv = document.getElementById('error-message');

                    if (user === 'admin' && pass === 'admin') {
                        window.location.href = '@Url.Action("Index", "AdminHome")';
                    } else if (user === 'profe' && pass === 'profe') {
                        window.location.href = '@Url.Action("Profesor", "Dashboard")';
                    } else if (user === 'est' && pass === 'est') {
                        window.location.href = '@Url.Action("Index", "StudentHome")';
                    } else {
                        errorDiv.style.display = 'block';
                    }
                }
            </script>
            <div class="links">
                <a asp-controller="Account" asp-action="Registro">¿No tienes cuenta?</a>
                <a asp-controller="Account" asp-action="Recuperacion">¿Olvidaste tu contraseña?</a>
            </div>
        </div>
    </div>
</body>
</html>
