@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Planilla de Notas";
    ViewData["BreadcrumbParent"] = "ACADÉMICO";
    ViewData["BreadcrumbTitle"] = "PLANILLA DE NOTAS";
}

<!-- ESTILOS EXCLUSIVOS DE LA VISTA DE CALIFICACIONES (PREMIUM Y RESPONSIVO) -->
<style>
    /* Estilos Generales de Contenedores y Secciones */
    .cal-kpis-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
        margin-bottom: 24px;
    }

    .cal-kpi-card {
        background-color: #ffffff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(6, 37, 66, 0.04);
        border: 1px solid rgba(6, 37, 66, 0.05);
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        transition: transform 0.25s ease;
    }

    .cal-kpi-card:hover {
        transform: translateY(-2px);
    }

    .cal-kpi-icon-wrapper {
        width: 52px;
        height: 52px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }

    .cal-kpi-info {
        display: flex;
        flex-direction: column;
    }

    .cal-kpi-label {
        font-size: 11px;
        text-transform: uppercase;
        font-weight: 700;
        color: #7c8ba1;
        letter-spacing: 0.5px;
    }

    .cal-kpi-value {
        font-size: 24px;
        font-weight: 800;
        color: #062542;
        margin: 4px 0 2px 0;
    }

    .cal-kpi-value span {
        font-size: 14px;
        font-weight: 500;
        color: #7c8ba1;
    }

    .cal-kpi-subtitle {
        font-size: 11px;
        color: #7c8ba1;
    }

    /* Colores por KPI */
    .kpi-blue { border-left: 4px solid #3b82f6; }
    .kpi-blue .cal-kpi-icon-wrapper { background-color: rgba(59, 130, 246, 0.1); color: #3b82f6; }

    .kpi-green { border-left: 4px solid #1fb398; }
    .kpi-green .cal-kpi-icon-wrapper { background-color: rgba(31, 179, 152, 0.1); color: #1fb398; }

    .kpi-red { border-left: 4px solid #ff5757; }
    .kpi-red .cal-kpi-icon-wrapper { background-color: rgba(255, 87, 87, 0.1); color: #ff5757; }

    /* Layout Principal: Cursos + Planilla */
    .cal-main-layout {
        display: flex;
        gap: 24px;
        align-items: flex-start;
        flex-wrap: wrap;
    }

    /* Listado de Cursos (Columna Izquierda) */
    .cal-courses-sidebar {
        flex: 0 0 300px;
        background-color: #ffffff;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 4px 20px rgba(6, 37, 66, 0.04);
        border: 1px solid rgba(6, 37, 66, 0.05);
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .cal-sidebar-title {
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        color: #062542;
        letter-spacing: 1px;
        margin-bottom: 8px;
    }

    .cal-course-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .cal-course-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px;
        border-radius: 12px;
        border: 1.5px solid rgba(6, 37, 66, 0.06);
        background-color: #ffffff;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
        color: #062542;
        text-decoration: none;
    }

    .cal-course-item:hover {
        background-color: #f7fafc;
        border-color: rgba(6, 37, 66, 0.15);
    }

    .cal-course-item.active {
        background-color: #edf2f9;
        border-color: #3b82f6;
        font-weight: 600;
    }

    .cal-course-item.active i {
        color: #3b82f6;
        transform: translateX(3px);
    }

    .cal-course-name {
        font-size: 14px;
        font-weight: 600;
        margin: 0;
    }

    .cal-course-students {
        font-size: 11px;
        color: #7c8ba1;
        margin: 2px 0 0 0;
    }

    .cal-course-item i {
        font-size: 14px;
        color: #7c8ba1;
        transition: transform 0.2s;
    }

    /* Planilla de Calificaciones (Columna Derecha) */
    .cal-sheet-container {
        flex: 1;
        min-width: 500px;
        background-color: #ffffff;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 4px 20px rgba(6, 37, 66, 0.04);
        border: 1px solid rgba(6, 37, 66, 0.05);
        display: flex;
        flex-direction: column;
    }

    .cal-sheet-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .cal-sheet-title h3 {
        font-size: 20px;
        font-weight: 700;
        color: #062542;
        margin: 0;
    }

    .cal-sheet-title p {
        font-size: 12px;
        color: #7c8ba1;
        margin: 4px 0 0 0;
    }

    .cal-actions-group {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-cal {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        border: 1.5px solid transparent;
        background: none;
    }

    .btn-cal-outline {
        border-color: rgba(6, 37, 66, 0.15);
        color: #062542;
    }

    .btn-cal-outline:hover {
        background-color: rgba(6, 37, 66, 0.03);
        border-color: #062542;
    }

    .btn-cal-filled {
        background-color: #062542;
        color: #ffffff;
    }

    .btn-cal-filled:hover {
        background-color: #0d3862;
    }

    /* Tabla de Calificaciones */
    .cal-table-wrapper {
        overflow-x: auto;
        margin-bottom: 20px;
    }

    .cal-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }

    .cal-table th {
        padding: 14px 10px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        color: #7c8ba1;
        letter-spacing: 0.5px;
        border-bottom: 1.5px solid rgba(6, 37, 66, 0.08);
    }

    .cal-table th.col-activity {
        text-align: center;
        background-color: #f8fafc;
    }

    .activity-weight {
        display: block;
        font-size: 9px;
        font-weight: 500;
        color: #3b82f6;
        margin-top: 3px;
        background-color: rgba(59, 130, 246, 0.08);
        padding: 2px 6px;
        border-radius: 4px;
        width: fit-content;
        margin-left: auto;
        margin-right: auto;
    }

    .cal-table td {
        padding: 14px 10px;
        border-bottom: 1px solid rgba(6, 37, 66, 0.05);
        vertical-align: middle;
        font-size: 13px;
    }

    .cal-table tr:hover {
        background-color: rgba(235, 241, 254, 0.25);
    }

    /* Estilos Estudiante */
    .cal-student-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .cal-student-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 11px;
        flex-shrink: 0;
    }

    /* Colores avatares */
    .avatar-blue { background-color: rgba(59, 130, 246, 0.1); color: #3b82f6; }
    .avatar-purple { background-color: rgba(168, 85, 247, 0.1); color: #a855f7; }
    .avatar-indigo { background-color: rgba(99, 102, 241, 0.1); color: #6366f1; }
    .avatar-grey { background-color: rgba(100, 116, 139, 0.1); color: #64748b; }
    
    .student-fullname {
        font-weight: 600;
        color: #062542;
    }

    /* Inputs de Notas */
    .grade-input {
        width: 60px;
        padding: 8px;
        border: 1px solid rgba(6, 37, 66, 0.15);
        border-radius: 8px;
        text-align: center;
        font-size: 13px;
        font-weight: 600;
        color: #062542;
        transition: all 0.2s;
        outline: none;
    }

    .grade-input:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }

    .grade-input.danger-grade {
        border-color: #ff5757 !important;
        color: #ff5757 !important;
        background-color: rgba(255, 87, 87, 0.03);
    }

    .grade-input::-webkit-outer-spin-button,
    .grade-input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .grade-input[type=number] {
        -moz-appearance: textfield;
    }

    /* Nueva Columna Dotted */
    .new-activity-cell {
        border: 1px dashed rgba(6, 37, 66, 0.15) !important;
        background-color: rgba(248, 250, 252, 0.4);
        color: #7c8ba1;
        font-weight: 500;
        text-align: center;
    }

    /* Notas Definitivas */
    .def-grade-value {
        font-size: 14px;
        font-weight: 700;
        text-align: center;
    }

    .def-grade-value.text-success { color: #1fb398; }
    .def-grade-value.text-warning { color: #f59e0b; }
    .def-grade-value.text-danger { color: #ff5757; }

    /* Badges de Estado */
    .cal-badge {
        font-size: 10px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 12px;
        text-transform: uppercase;
        display: inline-block;
        text-align: center;
    }

    .cal-badge-success {
        background-color: rgba(31, 179, 152, 0.1);
        color: #1fb398;
    }

    .cal-badge-warning {
        background-color: rgba(245, 158, 11, 0.1);
        color: #f59e0b;
    }

    .cal-badge-danger {
        background-color: rgba(255, 87, 87, 0.1);
        color: #ff5757;
    }

    /* Paginación */
    .cal-pagination-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: auto;
        padding-top: 16px;
        border-top: 1px solid rgba(6, 37, 66, 0.05);
        flex-wrap: wrap;
        gap: 12px;
    }

    .cal-pagination-text {
        font-size: 12px;
        color: #7c8ba1;
        font-weight: 500;
    }

    .cal-pagination-controls {
        display: flex;
        gap: 6px;
    }

    .btn-page {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        border: 1px solid rgba(6, 37, 66, 0.1);
        background-color: #ffffff;
        color: #062542;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }

    .btn-page:hover {
        background-color: #f8fafc;
        border-color: rgba(6, 37, 66, 0.2);
    }

    .btn-page.active {
        background-color: #062542;
        color: #ffffff;
        border-color: #062542;
    }

    /* Adaptabilidad */
    @@media (max-width: 992px) {
        .cal-main-layout {
            flex-direction: column;
            align-items: stretch;
        }

        .cal-courses-sidebar {
            flex: auto;
        }

        .cal-sheet-container {
            min-width: auto;
        }
    }
</style>

<!-- KPIS SUPERIORES -->
<div class="cal-kpis-grid">
    <div class="cal-kpi-card kpi-blue">
        <div class="cal-kpi-icon-wrapper">
            <i class="fa-solid fa-users"></i>
        </div>
        <div class="cal-kpi-info">
            <span class="cal-kpi-label">Curso Seleccionado</span>
            <span class="cal-kpi-value" id="kpi-selected-course">Matemáticas 11-B</span>
            <span class="cal-kpi-subtitle">Periodo Lectivo 2026</span>
        </div>
    </div>

    <div class="cal-kpi-card kpi-green">
        <div class="cal-kpi-icon-wrapper">
            <i class="fa-solid fa-chart-line"></i>
        </div>
        <div class="cal-kpi-info">
            <span class="cal-kpi-label">Promedio Grupal</span>
            <span class="cal-kpi-value" id="kpi-group-average">4.2 <span>/ 5.0</span></span>
            <span class="cal-kpi-subtitle">Basado en periodo actual</span>
        </div>
    </div>

    <div class="cal-kpi-card kpi-red">
        <div class="cal-kpi-icon-wrapper">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <div class="cal-kpi-info">
            <span class="cal-kpi-label">Estudiantes en Riesgo</span>
            <span class="cal-kpi-value" id="kpi-students-risk">1 <span>Bajo el umbral</span></span>
            <span class="cal-kpi-subtitle">Nota promedio < 3.0</span>
        </div>
    </div>
</div>

