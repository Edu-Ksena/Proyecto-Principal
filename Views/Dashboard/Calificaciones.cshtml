                        </td>
                        <td class="new-activity-cell">—</td>
                        <td style="text-align: center;">
                            <span class="def-grade-value text-success">4.1</span>
                        </td>
                        <td style="text-align: center;">
                            <span class="cal-badge cal-badge-success">Aprobado</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- PIE DE PAGINACIÓN -->
        <div class="cal-pagination-footer">
            <span class="cal-pagination-text" id="pagination-text">Mostrando 5 de 32 estudiantes</span>
            <div class="cal-pagination-controls">
                <button class="btn-page"><i class="fa-solid fa-angle-left"></i></button>
                <button class="btn-page active">1</button>
                <button class="btn-page">2</button>
                <button class="btn-page">3</button>
                <button class="btn-page"><i class="fa-solid fa-angle-right"></i></button>
            </div>
        </div>
    </section>

</div>

@section Scripts {
    <script>
        // Establecer active en menú lateral
        document.addEventListener("DOMContentLoaded", function() {
            document.querySelectorAll(".db-nav-item").forEach(item => {
                item.classList.remove("active");
            });
            const navCalificaciones = document.getElementById("nav-calificaciones");
            if (navCalificaciones) {
                navCalificaciones.classList.add("active");
            }
            recalculateSummary();
        });

        // Simular Cambio de Curso
        function selectCourse(courseName, studentCount, initialAverage) {
            // Cambiar clase active en sidebar
            document.querySelectorAll(".cal-course-item").forEach(item => {
                item.classList.remove("active");
            });
            
            // Buscar elemento
            let elementId = "";
            if (courseName.includes("11-B")) elementId = "course-mat11b";
            else if (courseName.includes("10-A")) elementId = "course-mat10a";
            else if (courseName.includes("11-A")) elementId = "course-cal11a";
            else if (courseName.includes("10-B")) elementId = "course-tri10b";

            const activeItem = document.getElementById(elementId);
            if (activeItem) activeItem.classList.add("active");

            // Cambiar textos y KPIs
            document.getElementById("kpi-selected-course").textContent = courseName;
            document.getElementById("pagination-text").textContent = `Mostrando 5 de ${studentCount} estudiantes`;

            // Cargar datos simulados diferentes por curso
            loadMockDataForCourse(courseName);
        }

        // Generar notas aleatorias coherentes para simulación
        function loadMockDataForCourse(courseName) {
            const tbody = document.getElementById("grades-tbody");
            const students = [
                { name: "Alvarado, Andres", avatar: "AA", cls: "avatar-blue" },
                { name: "Bernal, Camilo", avatar: "BC", cls: "avatar-purple" },
                { name: "Daza, Claudia", avatar: "DC", cls: "avatar-indigo" },
                { name: "Estrada, Gabriel", avatar: "EG", cls: "avatar-grey" },
                { name: "Franco, Sofia", avatar: "FS", cls: "avatar-blue" }
            ];

            tbody.innerHTML = "";

            students.forEach((s, idx) => {
                let act1, act2, parcial;
                
                // Variar notas basadas en el curso para que cambien visualmente
                if (courseName.includes("11-A")) { // Cálculo
                    act1 = (4.0 + Math.random()).toFixed(1);
                    act2 = (3.8 + Math.random()).toFixed(1);
                    parcial = (4.2 + Math.random() * 0.8).toFixed(1);
                } else if (courseName.includes("10-A")) { // Matemáticas 10-A (peores notas para simular más riesgo)
                    act1 = (2.0 + Math.random() * 2).toFixed(1);
                    act2 = (2.5 + Math.random() * 1.8).toFixed(1);
                    parcial = (2.2 + Math.random() * 2).toFixed(1);
                } else if (courseName.includes("10-B")) { // Trigonometría
                    act1 = (3.0 + Math.random() * 1.5).toFixed(1);
                    act2 = (3.5 + Math.random() * 1.2).toFixed(1);
                    parcial = (3.2 + Math.random() * 1.5).toFixed(1);
                } else { // Matemáticas 11-B (Valores de la imagen)
                    act1 = idx === 0 ? "4.5" : idx === 1 ? "2.5" : idx === 2 ? "5.0" : idx === 3 ? "3.5" : "4.2";
                    act2 = idx === 0 ? "4.0" : idx === 1 ? "3.0" : idx === 2 ? "4.8" : idx === 3 ? "3.2" : "4.1";
                    parcial = idx === 0 ? "3.8" : idx === 1 ? "2.8" : idx === 2 ? "4.5" : idx === 3 ? "3.4" : "4.0";
                }

                // Ajustar al máximo de 5.0
                act1 = Math.min(5.0, parseFloat(act1)).toFixed(1);
                act2 = Math.min(5.0, parseFloat(act2)).toFixed(1);
                parcial = Math.min(5.0, parseFloat(parcial)).toFixed(1);

                // Calcular promedio
                const defVal = ((parseFloat(act1) + parseFloat(act2) + parseFloat(parcial)) / 3).toFixed(1);
                
                // Determinar estado
                let badgeClass = "cal-badge-success";
                let badgeText = "Aprobado";
                let textClass = "text-success";

                if (defVal < 3.0) {
                    badgeClass = "cal-badge-danger";
                    badgeText = "En Riesgo";
                    textClass = "text-danger";
                } else if (defVal < 4.0) {
                    badgeClass = "cal-badge-warning";
                    badgeText = "Regular";
                    textClass = "text-warning";
                }

                const tr = document.createElement("tr");
                tr.setAttribute("data-student-id", idx + 1);
                tr.innerHTML = `
                    <td style="text-align: center; color: #7c8ba1; font-weight: 500;">${idx + 1}</td>
                    <td>
                        <div class="cal-student-cell">
                            <div class="cal-student-avatar ${s.cls}">${s.avatar}</div>
                            <span class="student-fullname">${s.name}</span>
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <input type="number" class="grade-input ${act1 < 3.0 ? 'danger-grade' : ''}" step="0.1" min="0" max="5" value="${act1}" onchange="recalculateRow(this)">
                    </td>
                    <td style="text-align: center;">
                        <input type="number" class="grade-input ${act2 < 3.0 ? 'danger-grade' : ''}" step="0.1" min="0" max="5" value="${act2}" onchange="recalculateRow(this)">
                    </td>
                    <td style="text-align: center;">
                        <input type="number" class="grade-input ${parcial < 3.0 ? 'danger-grade' : ''}" step="0.1" min="0" max="5" value="${parcial}" onchange="recalculateRow(this)">
                    </td>
                    <td class="new-activity-cell">—</td>
                    <td style="text-align: center;">
                        <span class="def-grade-value ${textClass}">${defVal}</span>
                    </td>
                    <td style="text-align: center;">
                        <span class="cal-badge ${badgeClass}">${badgeText}</span>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            recalculateSummary();
        }

        // Recalcular fila individualmente al cambiar nota
        function recalculateRow(input) {
            // Validar límites
            let val = parseFloat(input.value);
            if (isNaN(val) || val < 0) {
                input.value = "0.0";
                val = 0;
            } else if (val > 5.0) {
                input.value = "5.0";
                val = 5.0;
            } else {
                input.value = val.toFixed(1);
            }

            // Aplicar borde rojo si es menor a 3.0
            if (val < 3.0) {
                input.classList.add("danger-grade");
            } else {
                input.classList.remove("danger-grade");
            }

            // Obtener fila y todas sus notas
            const row = input.closest("tr");
            const inputs = row.querySelectorAll(".grade-input");
            let sum = 0;
            inputs.forEach(inp => {
                sum += parseFloat(inp.value);
            });

            // Promedio simple de las 3 actividades
            const avg = (sum / inputs.length).toFixed(1);

            // Actualizar columna DEF
            const defCell = row.querySelector(".def-grade-value");
            defCell.textContent = avg;

            // Actualizar Estado
            const badgeCell = row.querySelector(".cal-badge");
            
            // Eliminar clases previas
            defCell.className = "def-grade-value";
            badgeCell.className = "cal-badge";

            if (avg < 3.0) {
                defCell.classList.add("text-danger");
                badgeCell.classList.add("cal-badge-danger");
                badgeCell.textContent = "En Riesgo";
            } else if (avg < 4.0) {
                defCell.classList.add("text-warning");
                badgeCell.classList.add("cal-badge-warning");
                badgeCell.textContent = "Regular";
            } else {
                defCell.classList.add("text-success");
                badgeCell.classList.add("cal-badge-success");
                badgeCell.textContent = "Aprobado";
            }

            // Recalcular KPIs superiores
            recalculateSummary();
        }

        // Recalcular Promedio Grupal y Estudiantes en Riesgo del cuadro superior
        function recalculateSummary() {
            const defs = document.querySelectorAll(".def-grade-value");
            let totalSum = 0;
            let countInRisk = 0;

            defs.forEach(def => {
                const val = parseFloat(def.textContent);
                totalSum += val;
                if (val < 3.0) {
                    countInRisk++;
                }
            });

            const groupAvg = (totalSum / defs.length).toFixed(1);
            
            // Actualizar KPIs
            document.getElementById("kpi-group-average").innerHTML = `${groupAvg} <span>/ 5.0</span>`;
            document.getElementById("kpi-students-risk").innerHTML = `${countInRisk} <span>Bajo el umbral</span>`;
        }

        // Simulación de guardar
        function saveChanges() {
            alert("¡Cambios guardados con éxito localmente!");
        }

        // Simulación de publicar
        function publishGrades() {
            alert("¡Las notas se han publicado exitosamente en el portal del estudiante!");
        }
    </script>
}
