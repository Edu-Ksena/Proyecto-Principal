@{
    // Empleamos el layout unificado del dashboard del docente
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Mi perfil";
    ViewData["BreadcrumbParent"] = "Inicio";
    ViewData["BreadcrumbTitle"] = "Mi perfil";
}

<!-- ESTILOS INTERNOS DE PERFIL ADICIONALES (MANTENIENDO PALETA #062542) -->
<style>
    /* Cabecera del Banner del Perfil del Docente */
    .profile-hero-banner {
        background-color: #062542; /* Color principal */
        border-radius: 16px;
        padding: 30px;
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
        box-shadow: 0 10px 25px rgba(6, 37, 66, 0.15);
    }
    
    .profile-hero-left {
        display: flex;
        align-items: center;
        gap: 20px;
    }
    
    .profile-large-avatar {
        width: 80px;
        height: 80px;
        background-color: #ff5757; /* Color de acento rojo/naranja del avatar */
        color: #ffffff;
        font-size: 32px;
        font-weight: 700;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 4px solid rgba(255, 255, 255, 0.2);
    }
    
    .profile-hero-details h2 {
        font-size: 24px;
        font-weight: 700;
        margin: 0;
    }
    
    .profile-hero-details p {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.7);
        margin: 4px 0 8px 0;
    }
    
    .profile-badge-profesor {
        background-color: #3b82f6;
        color: #ffffff;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        display: inline-block;
    }
    
    .btn-edit-profile {
        background-color: #3b82f6;
        color: #ffffff;
        border: none;
        padding: 12px 24px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
    }
    
    .btn-edit-profile:hover {
        background-color: #2563eb;
        transform: translateY(-2px);
    }
    
    /* Grid de tarjetas en doble columna */
    .profile-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }
    
    .profile-section-title {
        font-size: 12px;
        text-transform: uppercase;
        font-weight: 800;
        color: #3b82f6;
        letter-spacing: 1px;
        margin-bottom: 16px;
        display: block;
        border-bottom: 1px solid rgba(6, 37, 66, 0.05);
        padding-bottom: 8px;
    }
    
    .profile-row-info {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid rgba(6, 37, 66, 0.03);
        font-size: 14px;
    }
    
    .profile-row-info:last-child {
        border-bottom: none;
    }
    
    .profile-info-label {
        color: #666;
        font-weight: 500;
    }
    
    .profile-info-value {
        color: #062542;
        font-weight: 600;
        text-align: right;
    }
    
    .btn-change-password {
        background-color: #062542;
        color: #ffffff;
        border: none;
        padding: 6px 16px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s;
    }
    
    .btn-change-password:hover {
        background-color: #1fb398;
    }
    
    @@media (max-width: 1024px) {
        .profile-info-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<!-- BANNER HÉROE DEL PERFIL -->
<div class="profile-hero-banner">
    <div class="profile-hero-left">
        <div class="profile-large-avatar">JL</div>
        <div class="profile-hero-details">
            <h2>Juan Lopez</h2>
            <p>juan.lopez@gmail.com</p>
            <span class="profile-badge-profesor">Profesor</span>
        </div>
    </div>
    <button class="btn-edit-profile" onclick="alert('Formulario de edición en desarrollo')">
        <i class="fa-solid fa-pen-to-square"></i> Editar perfil
    </button>
</div>

<!-- GRID CON DATOS DE PERFIL -->
<div class="profile-info-grid">
    
    <!-- COLUMNA IZQUIERDA -->
    <div style="display: flex; flex-direction: column; gap: 24px;">
        
        <!-- TARJETA: INFORMACIÓN PERSONAL -->
        <div class="db-card">
            <span class="profile-section-title">Información Personal</span>
            <div class="profile-row-info">
                <span class="profile-info-label">Nombre completo</span>
                <span class="profile-info-value">Juan Lopez</span>
            </div>
            <div class="profile-row-info">
                <span class="profile-info-label">Correo electrónico</span>
                <span class="profile-info-value">juan.lopez@gmail.com</span>
            </div>
            <div class="profile-row-info">
                <span class="profile-info-label">Teléfono</span>
                <span class="profile-info-value">+57 310 000 0000</span>
            </div>
            <div class="profile-row-info">
                <span class="profile-info-label">Ciudad</span>
                <span class="profile-info-value">Bogotá, Colombia</span>
            </div>
            <div class="profile-row-info">
                <span class="profile-info-label">Vinculación</span>
                <span class="profile-info-value">Enero 2023</span>
            </div>
        </div>
        
        <!-- TARJETA: SEGURIDAD -->
        <div class="db-card">
            <span class="profile-section-title">Seguridad</span>
            <div class="profile-row-info" style="align-items: center;">
                <span class="profile-info-label">Contraseña</span>
                <button class="btn-change-password" onclick="alert('Enlace de restablecimiento enviado a tu correo')">Cambiar</button>
            </div>
            <div class="profile-row-info" style="align-items: center;">
                <span class="profile-info-label">Autenticación 2FA</span>
                <span class="db-pill db-pill-warning" style="padding: 4px 12px; font-size: 10px;">Desactivado</span>
            </div>
            <div class="profile-row-info">
                <span class="profile-info-label">Sesiones activas</span>
                <span class="profile-info-value">1 dispositivo</span>
            </div>
        </div>
        
    </div>
    
    <!-- COLUMNA DERECHA -->
    <div style="display: flex; flex-direction: column; gap: 24px;">
        
        <!-- TARJETA: INFORMACIÓN ACADÉMICA -->
        <div class="db-card">
            <span class="profile-section-title">Información Académica</span>
            <div class="profile-row-info">
                <span class="profile-info-label">Institución</span>
                <span class="profile-info-value">Gotitas del Saber</span>
            </div>
            <div class="profile-row-info">
                <span class="profile-info-label">Rol</span>
                <span class="profile-info-value">Profesor</span>
            </div>
            <div class="profile-row-info">
                <span class="profile-info-label">Cursos asignados</span>
                <span class="profile-info-value">5 cursos</span>
            </div>
            <div class="profile-row-info">
                <span class="profile-info-label">Total estudiantes</span>
                <span class="profile-info-value">128</span>
            </div>
            <div class="profile-row-info">
                <span class="profile-info-label">Año lectivo</span>
                <span class="profile-info-value">2026</span>
            </div>
            <div class="profile-row-info">
                <span class="profile-info-label">Promedio calificaciones</span>
                <span class="profile-info-value">3.8 / 5.0</span>
            </div>
        </div>
        
        <!-- TARJETA: CONFIGURACIÓN DE NOTIFICACIONES -->
        <div class="db-card">
            <span class="profile-section-title">Notificaciones</span>
            <div class="profile-row-info" style="align-items: center;">
                <span class="profile-info-label">Correo</span>
                <span class="db-pill db-pill-success" style="padding: 4px 12px; font-size: 10px;">Activo</span>
            </div>
            <div class="profile-row-info" style="align-items: center;">
                <span class="profile-info-label">Push</span>
                <span class="db-pill db-pill-success" style="padding: 4px 12px; font-size: 10px;">Activo</span>
            </div>
            <div class="profile-row-info" style="align-items: center;">
                <span class="profile-info-label">Resumen semanal</span>
                <span class="db-pill db-pill-warning" style="padding: 4px 12px; font-size: 10px;">Desactivado</span>
            </div>
            <div class="profile-row-info" style="align-items: center;">
                <span class="profile-info-label">SMS</span>
                <span class="db-pill db-pill-warning" style="padding: 4px 12px; font-size: 10px;">Desactivado</span>
            </div>
        </div>
        
    </div>
    
</div>

@section Scripts {
    <script>
        // JS comentado para activar la opción correspondiente en el menú lateral del profesor
        document.addEventListener("DOMContentLoaded", function() {
            // Remueve la selección activa previa
            document.querySelectorAll(".db-nav-item").forEach(item => {
                item.classList.remove("active");
            });
            // Habilita el estado active en Mi Perfil
            const navPerfil = document.getElementById("nav-perfil");
            if (navPerfil) {
                navPerfil.classList.add("active");
            }
        });
    </script>
}
