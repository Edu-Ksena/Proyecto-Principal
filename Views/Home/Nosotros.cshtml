@{
    ViewData["Title"] = "Sobre Nosotros";
}

<section class="about">
    <h2 class="Linea">Sobre nosotros</h2>
    <div class="about-container">
        <div class="about-text">
            <h3>Nuestra misión</h3>
            <p>
                EDU-K desarrolla software para optimizar la gestión académica y administrativa en instituciones privadas, 
                facilitando el manejo de la información y mejorando la organización del aprendizaje. 
            </p>

            <h3>Nuestra visión</h3>
            <p>
                EDU-K busca ser reconocido por su aporte al fortalecimiento de la gestión educativa a través de 
                herramientas tecnológicas innovadoras, con proyección a nivel nacional e institucional.
            </p>
        </div>
        <div class="about-img">
            <img src="~/images/about.png" alt="Equipo" asp-append-version="true">
        </div>
    </div>
</section>
