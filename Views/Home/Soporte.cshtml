@{
    ViewData["Title"] = "Soporte";
}

<section class="support">
    <h2 class="TituloSP">Soporte</h2>
    <p class="support-sub">
        ¿Tienes algún problema o duda? Escríbenos y te ayudamos.
    </p>

    <div class="support-container">
        <!-- FORMULARIO -->
        <form class="support-form">
            <input type="text" placeholder="Nombre" required>
            <input type="email" placeholder="Correo electrónico" required>
            <textarea placeholder="Escribe tu mensaje..." required></textarea>

            <button type="submit">Enviar mensaje</button>
        </form>

        <!-- INFO -->
        <div class="support-info">
            <h3>Contacto directo</h3>
            <p><i class="fas fa-envelope"></i> edu-ksoporte@gmail.com</p>
            <p><i class="fas fa-phone"></i> +57 300 000 0000</p>
            <p><i class="fas fa-clock"></i> Colombia </p>
            <p><i class="fas fa-clock"></i> Lun - Vie / 8:00 AM - 5:00 PM</p>
        </div>
    </div>
</section>
